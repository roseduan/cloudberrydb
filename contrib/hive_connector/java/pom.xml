<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>hashdata.cn</groupId>
    <artifactId>libhms</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- CVE fixes: last Java 8 compatible patch level -->
        <hadoop.version>2.10.2</hadoop.version>            <!-- overrides 2.8.0 (EOL) -->
        <log4j2.version>2.17.2</log4j2.version>            <!-- CVE-2021-44228 Log4Shell: overrides hive's transitive 2.8.2 -->
        <jetty.version>9.4.57.v20241219</jetty.version>    <!-- overrides hive's transitive 9.3.20; 9.4.60 (CVE-2026-2332) is commercial-ELS only, not on public Maven Central -->
        <avro.version>1.11.4</avro.version>                <!-- CVE-2024-47561: overrides hadoop's transitive 1.7.4 -->
        <!-- jackson 2.21.4: the metastore-client fat jar shipped jackson-databind 2.9.5 /
             jackson-core 2.4.0 / jackson-annotations 2.7.9 (unmanaged, dragged in via
             hive-metastore 3.1.0 + hadoop 2.x). 2.21.4 clears the whole 2018-2020
             deserialization CVE wave plus CVE-2026-54512/54513 (PTV / array-subtype
             allowlist bypass); still Java 8 baseline. Enforced via jackson-bom below.
             2.21.5 rather than 2.21.4 because 2.21.0-2.21.4 are themselves affected by
             GHSA-5gvw-p9qm-jgwh / GHSA-5jmj-h7xm-6q6v / GHSA-mhm7-754m-9p8w. -->
        <jackson.version>2.21.5</jackson.version>
        <!-- netty 4.1.136: fat jar shipped netty-all 4.1.12 / netty-buffer|common 4.1.17;
             enforced via netty-bom below. The legacy netty 3.10.6 (io.netty:netty,
             CVE-2019-20444/20445) is a SEPARATE artifact that hadoop-mapreduce-client-core
             2.10.2 pulls in for the Hadoop 2.x IPC layer; a version bump cannot replace it
             (different artifactId), so it is excluded explicitly on the hadoop-mapreduce-
             client-* dependencies below. A metastore client never exercises Hadoop MR IPC.
             4.1.136 adds the fixes for CVE-2026-56745 / CVE-2026-55831 / CVE-2026-55833
             (netty-codec-http), CVE-2026-56817 (netty-codec-xml) and the matching
             codec / codec-haproxy / codec-http2 / codec-stomp / handler-ssl-ocsp
             advisories that 4.1.135 is still flagged for. -->
        <netty.version>4.1.136.Final</netty.version>
        <!-- zookeeper 3.9.5: CVE-2023-44981 (old 3.4.x) + CVE-2026-24308/24281 (3.9.x);
             overrides the transitive version pulled via hive/curator. -->
        <zookeeper.version>3.9.5</zookeeper.version>
        <!-- protobuf 3.25.5: CVE-2021-22569 / CVE-2024-7254 (fat jar shipped 3.3.1). -->
        <protobuf.version>3.25.5</protobuf.version>
        <!-- commons-collections 3.2.2: CVE-2015-7501 / CVE-2015-6420 (fat jar shipped 3.2.1). -->
        <commons-collections.version>3.2.2</commons-collections.version>
        <!-- jettison 1.5.4: CVE-2022-40149/45685/45693, CVE-2023-1436 (fat jar shipped 1.1). -->
        <jettison.version>1.5.4</jettison.version>
        <!-- commons-io 2.16.1: CVE-2024-47554 (fat jar shipped 2.5). -->
        <commons-io.version>2.16.1</commons-io.version>
        <!-- gson 2.10.1: CVE-2022-25647 (fat jar shipped 2.8.1). -->
        <gson.version>2.10.1</gson.version>
        <!-- commons-compress 1.26.1: CVE-2024-25710/26308 (fat jar shipped 1.21). -->
        <commons-compress.version>1.26.1</commons-compress.version>
        <!-- aircompressor 0.27: bump from the 0.10 shipped. CVE-2025-67721 is fixed only in
             2.0.3, which renames the packages (io.airlift.compress -> io.airlift.compress.v3)
             and would break hive/iceberg's compiled callers, so 0.x stays and the CVE is
             carried as an accepted risk. -->
        <aircompressor.version>0.27</aircompressor.version>
        <!-- ant 1.10.15: CVE-2020-11979 (overrides hive-common's transitive 1.9.1) -->
        <ant.version>1.10.15</ant.version>
        <!-- jersey 1.19.4: CVE-2014-3643 XXE (overrides hadoop 2.x's transitive 1.9) -->
        <jersey.version>1.19.4</jersey.version>
        <!-- nimbus-jose-jwt 9.37.4: CVE-2023-52428; 10.x needs Java 11, this module is Java 8 -->
        <nimbus-jose-jwt.version>9.37.4</nimbus-jose-jwt.version>
        <!-- json-smart 2.4.11: CVE-2023-1370 (transitive via nimbus-jose-jwt / hadoop-auth) -->
        <json-smart.version>2.4.11</json-smart.version>
        <!-- commons-beanutils 1.11.0: CVE-2025-48734 -->
        <commons-beanutils.version>1.11.0</commons-beanutils.version>
        <!-- libthrift 0.13.0: CVE-2018-1320 / CVE-2019-0205 (overrides hive 3.1.0's 0.9.3) -->
        <libthrift.version>0.13.0</libthrift.version>
        <!-- httpclient 4.5.14: CVE-2020-13956 (the fat jar resolves 4.5.6 via hive/hadoop) -->
        <httpclient.version>4.5.14</httpclient.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ===== CVE fixes: BOM imports first (under import scope, first declaration wins) ===== -->
            <!-- jackson 2.21.4: converge the whole jackson family (databind/core/annotations)
                 that hive-metastore 3.1.0 + hadoop 2.x otherwise leave at 2.9.5 / 2.4.0 / 2.7.9 -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- netty 4.1.135: converge netty-all / netty-buffer / netty-common (shipped 4.1.12 / 4.1.17) -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Log4Shell etc.: force the whole log4j2 family to 2.17.2 (overrides hive-standalone-metastore's 2.8.2) -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>${log4j2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- jetty 9.4.57: overrides hive-common's transitive 9.3.20 -->
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-bom</artifactId>
                <version>${jetty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- avro 1.11.4: CVE-2024-47561 RCE (overrides hadoop's transitive 1.7.4) -->
            <dependency>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro</artifactId>
                <version>${avro.version}</version>
            </dependency>
            <!-- ===== Hadoop version convergence =====
                 The pom pins only hadoop-mapreduce-client-* to 2.10.2, but hive-metastore
                 3.1.0 drags hadoop-common / hadoop-auth in at 2.7.1 (CVE-2021-37404,
                 CVE-2022-26612, CVE-2022-25168 ...) and hadoop-hdfs at 2.2.0. Pin them to
                 2.10.2 so the graph is internally consistent with the mapreduce-client deps.
                 (The YARN server modules: resourcemanager / applicationhistoryservice /
                 web-proxy are server-side and pulled only transitively via hive-shims-0.23
                 at runtime scope; a metastore client never loads them, so they are excluded
                 outright on the hive-metastore dependency below rather than pinned.) -->
            <dependency>
                <groupId>org.apache.hadoop</groupId>
                <artifactId>hadoop-common</artifactId>
                <version>${hadoop.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.hadoop</groupId>
                <artifactId>hadoop-auth</artifactId>
                <version>${hadoop.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.hadoop</groupId>
                <artifactId>hadoop-hdfs</artifactId>
                <version>${hadoop.version}</version>
            </dependency>
            <!-- hadoop-yarn-server-common (CVE-2021-33036) enters at 2.10.2 via
                 hadoop-mapreduce-client-shuffle (compile); pin it so it can never drift back
                 to the vulnerable 3.1.0 that hive-shims used to pull. -->
            <dependency>
                <groupId>org.apache.hadoop</groupId>
                <artifactId>hadoop-yarn-server-common</artifactId>
                <version>${hadoop.version}</version>
            </dependency>
            <!-- zookeeper 3.9.5: CVE-2023-44981 + CVE-2026-24308/24281 -->
            <dependency>
                <groupId>org.apache.zookeeper</groupId>
                <artifactId>zookeeper</artifactId>
                <version>${zookeeper.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.zookeeper</groupId>
                <artifactId>zookeeper-jute</artifactId>
                <version>${zookeeper.version}</version>
            </dependency>
            <!-- commons-collections 3.2.2: CVE-2015-7501 / CVE-2015-6420 -->
            <dependency>
                <groupId>commons-collections</groupId>
                <artifactId>commons-collections</artifactId>
                <version>${commons-collections.version}</version>
            </dependency>
            <!-- protobuf 3.25.5: CVE-2021-22569 / CVE-2024-7254 -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java-util</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <!-- jettison 1.5.4: CVE-2022-40149/45685/45693, CVE-2023-1436 -->
            <dependency>
                <groupId>org.codehaus.jettison</groupId>
                <artifactId>jettison</artifactId>
                <version>${jettison.version}</version>
            </dependency>
            <!-- commons-io 2.16.1: CVE-2024-47554 -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons-io.version}</version>
            </dependency>
            <!-- gson 2.10.1: CVE-2022-25647 -->
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>
            <!-- commons-compress 1.26.1: CVE-2024-25710/26308 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>${commons-compress.version}</version>
            </dependency>
            <!-- aircompressor 0.27: bump from 0.10 (last io.airlift release) -->
            <dependency>
                <groupId>io.airlift</groupId>
                <artifactId>aircompressor</artifactId>
                <version>${aircompressor.version}</version>
            </dependency>
            <!-- ant 1.10.15: CVE-2020-11979 (fat jar shipped 1.9.1 via hive-common) -->
            <dependency>
                <groupId>org.apache.ant</groupId>
                <artifactId>ant</artifactId>
                <version>${ant.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.ant</groupId>
                <artifactId>ant-launcher</artifactId>
                <version>${ant.version}</version>
            </dependency>
            <!-- jersey 1.19.4: CVE-2014-3643 XXE (fat jar shipped 1.9 via hadoop 2.x) -->
            <dependency>
                <groupId>com.sun.jersey</groupId>
                <artifactId>jersey-core</artifactId>
                <version>${jersey.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sun.jersey</groupId>
                <artifactId>jersey-client</artifactId>
                <version>${jersey.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sun.jersey</groupId>
                <artifactId>jersey-server</artifactId>
                <version>${jersey.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sun.jersey</groupId>
                <artifactId>jersey-servlet</artifactId>
                <version>${jersey.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sun.jersey</groupId>
                <artifactId>jersey-json</artifactId>
                <version>${jersey.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sun.jersey.contribs</groupId>
                <artifactId>jersey-guice</artifactId>
                <version>${jersey.version}</version>
            </dependency>
            <!-- nimbus-jose-jwt 9.37.4: CVE-2023-52428 DoS (fat jar shipped 7.9 via
                 hadoop-auth). Staying on 9.x: 10.x requires Java 11, this module is Java 8. -->
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus-jose-jwt.version}</version>
            </dependency>
            <!-- json-smart 2.4.11: CVE-2023-1370 stack exhaustion (fat jar shipped 2.3) -->
            <dependency>
                <groupId>net.minidev</groupId>
                <artifactId>json-smart</artifactId>
                <version>${json-smart.version}</version>
            </dependency>
            <dependency>
                <groupId>net.minidev</groupId>
                <artifactId>accessors-smart</artifactId>
                <version>${json-smart.version}</version>
            </dependency>
            <!-- commons-beanutils 1.11.0: CVE-2025-48734 (1.9.4 is still affected) -->
            <dependency>
                <groupId>commons-beanutils</groupId>
                <artifactId>commons-beanutils</artifactId>
                <version>${commons-beanutils.version}</version>
            </dependency>
            <!-- libthrift 0.13.0: CVE-2018-1320 / CVE-2019-0205 (fat jar shipped 0.9.3).
                 0.13.0 is the ceiling that keeps hive 3.1.0's generated metastore stubs
                 working; CVE-2020-13949 (0.14.0) and CVE-2026-43869 (0.23.0) stay open. -->
            <dependency>
                <groupId>org.apache.thrift</groupId>
                <artifactId>libthrift</artifactId>
                <version>${libthrift.version}</version>
            </dependency>
            <!-- httpclient 4.5.14: CVE-2020-13956 -->
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>${httpclient.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.apache.hive</groupId>
            <artifactId>hive-metastore</artifactId>
            <version>3.1.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-web</artifactId>
                </exclusion>
                <!-- YARN server-side modules (CVE-2021-33036 etc.): pulled transitively via
                     hive-shims -> hive-shims-0.23 (runtime), previously at Hadoop 3.1.0 while
                     this client runs on Hadoop 2.10.2. A metastore client never loads YARN
                     ResourceManager / ApplicationHistoryService / WebProxy classes, so drop
                     them outright instead of shipping a cross-major-version mix. -->
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-yarn-server-resourcemanager</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-yarn-server-applicationhistoryservice</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-yarn-server-web-proxy</artifactId>
                </exclusion>
                <!-- #580: legacy Log4j 1.x (pulled via hbase-client -> hbase-common) -->
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
                <!-- CVE-2019-10172: Jackson 1.x (pulled via hbase -> hadoop-common 2.7.1) -->
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-core-asl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-mapper-asl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-jaxrs</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-xc</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-mapreduce-client-core</artifactId>
            <version>${hadoop.version}</version>
            <exclusions>
                <!-- #580: legacy Log4j 1.x (bundled by hadoop 2.x) -->
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
                <!-- netty 3.10.6 (CVE-2019-20444/20445): Hadoop 2.x IPC dep, unused by a
                     metastore client; drop it so the fat jar ships only netty 4.1.135 -->
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty</artifactId>
                </exclusion>
                <!-- CVE-2019-10172: Jackson 1.x (org.codehaus.jackson, pulled via hadoop-yarn-common) -->
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-core-asl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-mapper-asl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-jaxrs</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-xc</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-mapreduce-client-common</artifactId>
            <version>${hadoop.version}</version>
            <exclusions>
                <!-- #580: legacy Log4j 1.x (bundled by hadoop 2.x) -->
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
                <!-- netty 3.10.6 (CVE-2019-20444/20445): Hadoop 2.x IPC dep, unused by a
                     metastore client; drop it so the fat jar ships only netty 4.1.135 -->
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty</artifactId>
                </exclusion>
                <!-- CVE-2019-10172: Jackson 1.x (org.codehaus.jackson, via hadoop-yarn-common -> hadoop-common) -->
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-core-asl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-mapper-asl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-jaxrs</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-xc</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-mapreduce-client-jobclient</artifactId>
            <version>${hadoop.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
                <!-- netty 3.10.6 (CVE-2019-20444/20445): Hadoop 2.x IPC dep, unused by a
                     metastore client; drop it so the fat jar ships only netty 4.1.135 -->
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty</artifactId>
                </exclusion>
                <!-- CVE-2019-10172: Jackson 1.x (pulled via yarn-server-common -> yarn-registry) -->
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-core-asl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-mapper-asl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-jaxrs</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-xc</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.30</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.9.1</version>
                <executions>
                    <execution>
                    <phase>package</phase>
                    <goals>
                        <goal>makeAggregateBom</goal>
                    </goals>
                    </execution>
                </executions>
                <configuration>
                    <projectType>application</projectType>
                    <schemaVersion>1.6</schemaVersion>
                    <outputFormat>json</outputFormat>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <!-- #580 guard: ban legacy Log4j 1.x (log4j:log4j) from creeping back in transitively -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>ban-log4j1</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>log4j:log4j</exclude>
                                    </excludes>
                                    <message>Legacy Log4j 1.x (log4j:log4j) is excluded; do not reintroduce it (see #580).</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
