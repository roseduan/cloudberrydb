-- ============================================================
-- TIGHT-03: DATE column tightness — value on 1-week boundary
--           uses tight `d < value`, no `+ interval`.
-- ============================================================
\echo '=== TIGHT-03: DATE column boundary-aligned tightness ==='
=== TIGHT-03: DATE column boundary-aligned tightness ===
DO $$
DECLARE
    plan TEXT := '';
    line TEXT;
    cur  REFCURSOR;
    bound_value TEXT := NULL;
BEGIN
    OPEN cur FOR
        EXPLAIN (COSTS off, TIMING off, ANALYZE off)
        SELECT * FROM cv_date
         WHERE week < '2024-06-29'::date;  -- day 8946 from epoch = 7*1278 ✓
    LOOP
        FETCH cur INTO line;
        EXIT WHEN NOT FOUND;
        plan := plan || line || E'\n';
        IF line ~ '\(d <' THEN
            bound_value := substring(line FROM '\(d < ''([^'']+)''');
        END IF;
    END LOOP;
    CLOSE cur;

    IF bound_value IS NULL THEN
        RAISE NOTICE 'TIGHT-03 SKIP: no "d <" predicate pushed';
    ELSIF bound_value LIKE '%2024-06-29%' OR bound_value LIKE '%06-29-2024%' THEN
        RAISE NOTICE 'TIGHT-03 PASS: tight bound (= user date exactly: %)', bound_value;
    ELSE
        RAISE NOTICE 'TIGHT-03 NOTE: bound = % (may be loose form)', bound_value;
    END IF;
END $$;
NOTICE:  TIGHT-03 PASS: tight bound (= user date exactly: 06-29-2024)
-- ============================================================
-- TIGHT-04: Commutator form + boundary aligned + strict <
--           `'X' > bucket` is commutator of `bucket < 'X'`.
--           Walker should match commutator AND apply tightness.
-- ============================================================
\echo '=== TIGHT-04: commutator + tightness combo ==='
=== TIGHT-04: commutator + tightness combo ===
DO $$
DECLARE
    plan TEXT := '';
    line TEXT;
    cur  REFCURSOR;
    bound_value TEXT := NULL;
BEGIN
    OPEN cur FOR
        EXPLAIN (COSTS off, TIMING off, ANALYZE off)
        SELECT * FROM cv
         WHERE '2024-06-03 00:00+00'::timestamptz > bucket;
    LOOP
        FETCH cur INTO line;
        EXIT WHEN NOT FOUND;
        plan := plan || line || E'\n';
        IF line ~ '"time" <' THEN
            bound_value := substring(line FROM '"time" < ''([^'']+)''');
        END IF;
    END LOOP;
    CLOSE cur;

    IF bound_value IS NULL THEN
        RAISE NOTICE 'TIGHT-04 FAIL: no "time" < pushed (commutator may have failed)';
    ELSIF bound_value LIKE '%Jun 03 00:00:00 2024%' THEN
        RAISE NOTICE 'TIGHT-04 PASS: tight bound via commutator (= value exactly)';
    ELSIF bound_value LIKE '%Jun 03 01:00:00 2024%' THEN
        RAISE NOTICE 'TIGHT-04 NOTE: commutator works but tightness not applied (= value + 1h)';
    ELSE
        RAISE NOTICE 'TIGHT-04 UNEXPECTED: %', bound_value;
    END IF;
END $$;
NOTICE:  TIGHT-04 PASS: tight bound via commutator (= value exactly)
