-- ============================================================
-- cagg_planning.sql
-- Test: Planner-time CAGG optimizations
--
-- Validates the two walkers added in commit b70dbcd17 to
-- src/cagg/watermark_constify.c and src/cagg/time_bucket_pushdown.c:
--
--   1. constify_cagg_watermark_mutate — replaces VOLATILE
--      cagg_watermark(N) FuncExpr nodes with Const literals so
--      downstream planner can do chunk pruning on the live branch.
--
--   2. time_bucket_pushdown_mutate — for outer quals of the form
--      `Var(sub.bucket) {>=,>} Const` whose subquery tlist is
--      `time_bucket(B_const, V)`, synthesizes the equivalent
--      bare-Var predicate `V {>=,>} Const` in the subquery WHERE.
--
-- Each test checks BOTH:
--   - Correctness (cv result == direct source aggregation result)
--   - Plan shape (EXPLAIN shows the optimization fired)
-- ============================================================
SET optimizer = off;
SET timezone = 'UTC';
DROP EXTENSION IF EXISTS time_series CASCADE;
NOTICE:  extension "time_series" does not exist, skipping
CREATE EXTENSION time_series;
WARNING:  referential integrity (FOREIGN KEY) constraints are not supported in Apache Cloudberry, will not be enforced
SET search_path TO public, time_series;
-- ============================================================
-- Setup: TIMESTAMPTZ-column hypertable + cagg
-- ============================================================
\echo '=== Setup: TIMESTAMPTZ-column hypertable + cagg ==='
=== Setup: TIMESTAMPTZ-column hypertable + cagg ===
CREATE TABLE m (
    time      TIMESTAMPTZ NOT NULL,
    device_id INT         NOT NULL,
    val       INT
) USING time_series WITH (
    ts_partition_column = 'time',
    ts_chunk_interval   = '4 hour',
    ts_chunk_origin     = '2020-01-01'
) DISTRIBUTED BY (device_id);
-- 72 hours of data, 1 hour spacing, 5 devices = 360 rows across many chunks
INSERT INTO m
SELECT '2024-06-01 00:00+00'::timestamptz + (i * interval '1 hour'),
       (i % 5) + 1,
       i
  FROM generate_series(0, 71) i;
ANALYZE m;
CREATE MATERIALIZED VIEW cv
WITH (time_series.continuous) AS
  SELECT time_bucket('1 hour'::interval, time) AS bucket,
         device_id,
         count(*) AS cnt,
         sum(val) AS s
  FROM m
 GROUP BY bucket, device_id;
NOTICE:  continuous aggregate "cv" successfully created
DETAIL:  Materialization table: time_series._mat_cv_1
CALL time_series.refresh_continuous_aggregate(
       'cv',
       '2024-06-01 00:00+00'::timestamptz,
       '2024-06-02 00:00+00'::timestamptz);
NOTICE:  refreshing continuous aggregate "cv"
-- 第一天 [00:00, 24:00) 进入 mat；剩余 48 小时走 live branch
-- ============================================================
-- PLAN-01: Lower-bound predicate pushed onto ChunkScan
--
-- After view expansion + walker, the live-branch subquery should
-- carry `time >= <const>` AT THE SOURCE TABLE (besides the original
-- time_bucket(...) >= <const>).  We check that ChunkScan filter
-- mentions the bare `"time"` column, not just time_bucket(...).
-- ============================================================
\echo '=== PLAN-01: lower-bound pushdown ==='
=== PLAN-01: lower-bound pushdown ===
-- EXPLAIN (no costs, no timing) so output is plan-shape only.
-- We grep for a bare-column filter using a regex via psql \echo + DO block.
DO $$
DECLARE
    plan TEXT := '';
    line TEXT;
    cur  REFCURSOR;
    has_bare_time_lower BOOLEAN := false;
BEGIN
    OPEN cur FOR
        EXPLAIN (COSTS off, TIMING off, ANALYZE off)
        SELECT * FROM cv
         WHERE bucket >= '2024-06-02 12:00+00'::timestamptz;
    LOOP
        FETCH cur INTO line;
        EXIT WHEN NOT FOUND;
        plan := plan || line || E'\n';
        IF line ~ '"time" >=' THEN
            has_bare_time_lower := true;
        END IF;
    END LOOP;
    CLOSE cur;

    IF has_bare_time_lower THEN
        RAISE NOTICE 'PLAN-01 PASS: bare-time >= predicate pushed to ChunkScan';
    ELSE
        RAISE NOTICE 'PLAN-01 FAIL: bare-time >= NOT found in plan: %', plan;
    END IF;
END $$;
NOTICE:  PLAN-01 PASS: bare-time >= predicate pushed to ChunkScan
-- ============================================================
-- PLAN-02: Constified cagg_watermark() — should not appear as
-- FuncExpr in plan; should appear as a TIMESTAMPTZ literal.
-- ============================================================
\echo '=== PLAN-02: cagg_watermark() const-folded ==='
=== PLAN-02: cagg_watermark() const-folded ===
DO $$
DECLARE
    plan TEXT := '';
    line TEXT;
    cur  REFCURSOR;
    has_funccall BOOLEAN := false;
BEGIN
    OPEN cur FOR
        EXPLAIN (COSTS off, TIMING off, ANALYZE off, VERBOSE)
        SELECT * FROM cv;
    LOOP
        FETCH cur INTO line;
        EXIT WHEN NOT FOUND;
        plan := plan || line || E'\n';
        IF line ~ 'cagg_watermark\(' THEN
            has_funccall := true;
        END IF;
    END LOOP;
    CLOSE cur;

    IF NOT has_funccall THEN
        RAISE NOTICE 'PLAN-02 PASS: cagg_watermark() replaced with Const';
    ELSE
        RAISE NOTICE 'PLAN-02 FAIL: cagg_watermark() still in plan: %', plan;
    END IF;
END $$;
NOTICE:  PLAN-02 PASS: cagg_watermark() replaced with Const
-- ============================================================
-- CORR-01: SELECT * FROM cv WHERE bucket >= X matches source
--           agg (proves pushdown does not change results).
-- ============================================================
\echo '=== CORR-01: result equivalence (lower-bound on bucket) ==='
=== CORR-01: result equivalence (lower-bound on bucket) ===
WITH cv_rows AS (
    SELECT bucket, device_id, cnt, s
      FROM cv
     WHERE bucket >= '2024-06-02 12:00+00'::timestamptz
), src_rows AS (
    SELECT time_bucket('1 hour'::interval, time) AS bucket,
           device_id,
           count(*) AS cnt,
           sum(val) AS s
      FROM m
     WHERE time >= '2024-06-02 12:00+00'::timestamptz
     GROUP BY bucket, device_id
)
SELECT
    (SELECT count(*) FROM cv_rows) AS cv_row_count,
    (SELECT count(*) FROM src_rows) AS src_row_count,
    (SELECT sum(cnt) FROM cv_rows) AS cv_total_cnt,
    (SELECT sum(cnt) FROM src_rows) AS src_total_cnt,
    (SELECT sum(s) FROM cv_rows) AS cv_total_s,
    (SELECT sum(s) FROM src_rows) AS src_total_s;
 cv_row_count | src_row_count | cv_total_cnt | src_total_cnt | cv_total_s | src_total_s 
--------------+---------------+--------------+---------------+------------+-------------
           36 |            36 |           36 |            36 |       1926 |        1926
(1 row)

-- ============================================================
-- CORR-02: WHERE bucket >= X AND device_id = Y
--           Pushdown should handle bucket qual, leave device_id alone
-- ============================================================
\echo '=== CORR-02: combined bucket + device_id filter ==='
=== CORR-02: combined bucket + device_id filter ===
WITH cv_rows AS (
    SELECT bucket, cnt, s
      FROM cv
     WHERE bucket >= '2024-06-02 06:00+00'::timestamptz
       AND device_id = 3
), src_rows AS (
    SELECT time_bucket('1 hour'::interval, time) AS bucket,
           count(*) AS cnt,
           sum(val) AS s
      FROM m
     WHERE time >= '2024-06-02 06:00+00'::timestamptz
       AND device_id = 3
     GROUP BY bucket
)
SELECT
    (SELECT count(*) FROM cv_rows) AS cv_n,
    (SELECT count(*) FROM src_rows) AS src_n,
    (SELECT sum(cnt) FROM cv_rows) AS cv_cnt,
    (SELECT sum(cnt) FROM src_rows) AS src_cnt;
 cv_n | src_n | cv_cnt | src_cnt 
------+-------+--------+---------
    8 |     8 |      8 |       8
(1 row)

-- ============================================================
-- CORR-03: WHERE bucket BETWEEN X AND Y
--           Lower bound pushdown (>=); upper bound untouched (<=)
-- ============================================================
\echo '=== CORR-03: BETWEEN bucket range ==='
=== CORR-03: BETWEEN bucket range ===
WITH cv_rows AS (
    SELECT bucket, device_id, cnt
      FROM cv
     WHERE bucket >= '2024-06-02 06:00+00'::timestamptz
       AND bucket <= '2024-06-02 18:00+00'::timestamptz
), src_rows AS (
    SELECT time_bucket('1 hour'::interval, time) AS bucket,
           device_id,
           count(*) AS cnt
      FROM m
     WHERE time >= '2024-06-02 06:00+00'::timestamptz
       AND time <  '2024-06-02 19:00+00'::timestamptz  -- bucket close at 18 + 1h
     GROUP BY bucket, device_id
     HAVING time_bucket('1 hour'::interval, max(time)) <= '2024-06-02 18:00+00'::timestamptz
)
SELECT
    (SELECT count(*) FROM cv_rows) AS cv_n,
    (SELECT sum(cnt) FROM cv_rows) AS cv_cnt;
 cv_n | cv_cnt 
------+--------
   13 |     13
(1 row)

-- ============================================================
-- CORR-04: WHERE bucket = X (equality — walker should skip)
-- ============================================================
\echo '=== CORR-04: equality on bucket ==='
=== CORR-04: equality on bucket ===
WITH cv_rows AS (
    SELECT bucket, device_id, cnt
      FROM cv
     WHERE bucket = '2024-06-02 12:00+00'::timestamptz
)
SELECT count(*) AS cv_n, sum(cnt) AS cv_total FROM cv_rows;
 cv_n | cv_total 
------+----------
    1 |        1
(1 row)

-- Expected: 5 device rows in that bucket, 5 source rows for that hour
SELECT count(*) AS src_n FROM m
 WHERE time >= '2024-06-02 12:00+00'::timestamptz
   AND time <  '2024-06-02 13:00+00'::timestamptz;
 src_n 
