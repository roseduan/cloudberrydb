-- ============================================================
-- DATE-01: cagg over DATE-column hypertable
--           Verifies pushdown handles type-coercion correctly.
-- ============================================================
\echo '=== DATE-01: DATE-column hypertable ==='
=== DATE-01: DATE-column hypertable ===
CREATE TABLE m_date (
    d         DATE NOT NULL,
    device_id INT,
    val       INT
) USING time_series WITH (
    ts_partition_column = 'd',
    ts_chunk_interval   = '1 day',
    ts_chunk_origin     = '2020-01-01'
) DISTRIBUTED BY (device_id);
INSERT INTO m_date
SELECT '2024-06-01'::date + (i || ' day')::interval,
       (i % 5) + 1,
       i
  FROM generate_series(0, 29) i;
ANALYZE m_date;
CREATE MATERIALIZED VIEW cv_date
WITH (time_series.continuous) AS
  SELECT time_bucket('1 week'::interval, d) AS week,
         device_id,
         count(*) AS cnt
  FROM m_date
 GROUP BY week, device_id;
NOTICE:  continuous aggregate "cv_date" successfully created
DETAIL:  Materialization table: time_series._mat_cv_date_2
CALL refresh_continuous_aggregate(
       'cv_date',
       '2024-06-01'::timestamptz,
       '2024-06-15'::timestamptz);
NOTICE:  refreshing continuous aggregate "cv_date"
-- first two weeks materialized; rest is live branch
SELECT count(*) AS cv_date_n, sum(cnt) AS cv_date_cnt
  FROM cv_date
 WHERE week >= '2024-06-15'::date;
 cv_date_n | cv_date_cnt 
-----------+-------------
        10 |          14
(1 row)

SELECT count(DISTINCT (time_bucket('1 week'::interval, d), device_id)) AS src_n,
       count(*) AS src_cnt
  FROM m_date
 WHERE d >= '2024-06-15'::date;
 src_n | src_cnt 
-------+---------
