-- ============================================================
-- COMM-01: Commutator form — `Const op Var` should also push.
--          User writes the comparison with constant on the LEFT;
--          walker should match via get_commutator.
-- ============================================================
\echo '=== COMM-01: commutator form Const op Var ==='
=== COMM-01: commutator form Const op Var ===
-- `'2024-06-02 12:00' >= bucket` is equivalent to `bucket <= '2024-06-02 12:00'`
DO $$
DECLARE
    plan TEXT := '';
    line TEXT;
    cur  REFCURSOR;
    has_bare_time_upper BOOLEAN := false;
BEGIN
    OPEN cur FOR
        EXPLAIN (COSTS off, TIMING off, ANALYZE off)
        SELECT * FROM cv
         WHERE '2024-06-02 12:00+00'::timestamptz >= bucket;
    LOOP
        FETCH cur INTO line;
        EXIT WHEN NOT FOUND;
        plan := plan || line || E'\n';
        IF line ~ '"time" <' THEN
            has_bare_time_upper := true;
        END IF;
    END LOOP;
    CLOSE cur;

    IF has_bare_time_upper THEN
        RAISE NOTICE 'COMM-01 PASS: commutator form pushed';
    ELSE
        RAISE NOTICE 'COMM-01 FAIL: commutator form NOT pushed: %', plan;
    END IF;
END $$;
NOTICE:  COMM-01 PASS: commutator form pushed
-- Correctness vs symmetric form
WITH commuted AS (
    SELECT count(*) AS n, sum(cnt) AS c FROM cv
     WHERE '2024-06-02 12:00+00'::timestamptz >= bucket
), regular AS (
    SELECT count(*) AS n, sum(cnt) AS c FROM cv
     WHERE bucket <= '2024-06-02 12:00+00'::timestamptz
)
SELECT (SELECT n FROM commuted) AS commuted_n,
       (SELECT n FROM regular) AS regular_n,
       (SELECT c FROM commuted) AS commuted_c,
       (SELECT c FROM regular) AS regular_c;
 commuted_n | regular_n | commuted_c | regular_c 
------------+-----------+------------+-----------
         37 |        37 |         37 |        37
(1 row)

-- ============================================================
-- COMM-02: Lower-bound commutator form
-- ============================================================
\echo '=== COMM-02: commutator form for lower bound ==='
=== COMM-02: commutator form for lower bound ===
-- `'2024-06-02 12:00' <= bucket` is equivalent to `bucket >= '2024-06-02 12:00'`
WITH commuted AS (
    SELECT count(*) AS n FROM cv
     WHERE '2024-06-02 12:00+00'::timestamptz <= bucket
), regular AS (
    SELECT count(*) AS n FROM cv
     WHERE bucket >= '2024-06-02 12:00+00'::timestamptz
)
SELECT (SELECT n FROM commuted) AS commuted_n,
       (SELECT n FROM regular) AS regular_n;
 commuted_n | regular_n 
------------+-----------
         36 |        36
(1 row)

-- ============================================================
-- TIGHT-01: Boundary-aligned strict `<` uses tight `t < C` not `t < C+B`.
--           Value must be AFTER the watermark so the live branch isn't
--           eliminated by the planner (otherwise there's no ChunkScan
--           to push the bare-time predicate onto).
-- ============================================================
\echo '=== TIGHT-01: boundary-aligned strict < (TIMESTAMPTZ) ==='
=== TIGHT-01: boundary-aligned strict < (TIMESTAMPTZ) ===
DO $$
DECLARE
    plan TEXT := '';
    line TEXT;
    cur  REFCURSOR;
    bound_value TEXT := NULL;
BEGIN
    OPEN cur FOR
        EXPLAIN (COSTS off, TIMING off, ANALYZE off)
        SELECT * FROM cv
         WHERE bucket < '2024-06-03 00:00+00'::timestamptz;
    LOOP
        FETCH cur INTO line;
        EXIT WHEN NOT FOUND;
        plan := plan || line || E'\n';
        IF line ~ '"time" <' THEN
            bound_value := substring(line FROM '"time" < ''([^'']+)''');
        END IF;
    END LOOP;
    CLOSE cur;

    IF bound_value IS NULL THEN
        RAISE NOTICE 'TIGHT-01 FAIL: no "time" < pushed';
    ELSIF bound_value LIKE '%Jun 03 00:00:00 2024%' THEN
        RAISE NOTICE 'TIGHT-01 PASS: tight bound used (= user value exactly)';
    ELSIF bound_value LIKE '%Jun 03 01:00:00 2024%' THEN
        RAISE NOTICE 'TIGHT-01 FAIL: loose bound used (= user value + 1h)';
    ELSE
        RAISE NOTICE 'TIGHT-01 UNEXPECTED: %', bound_value;
    END IF;
END $$;
NOTICE:  TIGHT-01 PASS: tight bound used (= user value exactly)
-- ============================================================
-- TIGHT-02: Non-aligned value uses loose `t < C + B`
-- ============================================================
\echo '=== TIGHT-02: non-aligned strict < (TIMESTAMPTZ) ==='
=== TIGHT-02: non-aligned strict < (TIMESTAMPTZ) ===
DO $$
DECLARE
    plan TEXT := '';
    line TEXT;
    cur  REFCURSOR;
    bound_value TEXT := NULL;
BEGIN
    OPEN cur FOR
        EXPLAIN (COSTS off, TIMING off, ANALYZE off)
        SELECT * FROM cv
         WHERE bucket < '2024-06-03 12:30+00'::timestamptz;
    LOOP
        FETCH cur INTO line;
        EXIT WHEN NOT FOUND;
        plan := plan || line || E'\n';
        IF line ~ '"time" <' THEN
            bound_value := substring(line FROM '"time" < ''([^'']+)''');
        END IF;
    END LOOP;
    CLOSE cur;

    IF bound_value LIKE '%Jun 03 13:30:00 2024%' THEN
        RAISE NOTICE 'TIGHT-02 PASS: loose bound used (= user value + 1h)';
    ELSE
        RAISE NOTICE 'TIGHT-02 UNEXPECTED: %', bound_value;
    END IF;
END $$;
NOTICE:  TIGHT-02 PASS: loose bound used (= user value + 1h)
-- ============================================================
-- ORIGIN-01: 3-arg time_bucket with origin — walker should still work
--            but tightness optimization is skipped (boundaries shifted).
-- ============================================================
\echo '=== ORIGIN-01: time_bucket with origin ==='
=== ORIGIN-01: time_bucket with origin ===
CREATE MATERIALIZED VIEW cv_orig
WITH (time_series.continuous) AS
  SELECT time_bucket('1 hour'::interval, time, '2024-01-01 00:30+00'::timestamptz) AS bucket,
         device_id, count(*) AS cnt
    FROM m GROUP BY bucket, device_id;
NOTICE:  continuous aggregate "cv_orig" successfully created
DETAIL:  Materialization table: time_series._mat_cv_orig_4
CALL refresh_continuous_aggregate('cv_orig',
       '2024-06-01 00:00+00'::timestamptz,
       '2024-06-02 00:00+00'::timestamptz);
NOTICE:  refreshing continuous aggregate "cv_orig"
-- Correctness check: cv_orig with WHERE bucket >= X matches source
WITH cv_rows AS (
    SELECT bucket, device_id, cnt FROM cv_orig
     WHERE bucket >= '2024-06-02 12:30+00'::timestamptz
), src_rows AS (
    SELECT time_bucket('1 hour'::interval, time,
                       '2024-01-01 00:30+00'::timestamptz) AS bucket,
           device_id, count(*) AS cnt
      FROM m
     WHERE time_bucket('1 hour'::interval, time,
                       '2024-01-01 00:30+00'::timestamptz) >= '2024-06-02 12:30+00'::timestamptz
     GROUP BY bucket, device_id
)
SELECT
    (SELECT count(*) FROM cv_rows) AS cv_n,
    (SELECT count(*) FROM src_rows) AS src_n,
    (SELECT sum(cnt) FROM cv_rows) AS cv_cnt,
    (SELECT sum(cnt) FROM src_rows) AS src_cnt;
 cv_n | src_n | cv_cnt | src_cnt 
------+-------+--------+---------
   35 |    35 |     35 |      35
(1 row)

-- ============================================================
-- MONTH-01: Month interval should skip upper-bound optimization
--           (variable length).  Lower-bound still works.  Result correct.
-- ============================================================
\echo '=== MONTH-01: month-interval bucket — upper bound skipped ==='
=== MONTH-01: month-interval bucket — upper bound skipped ===
CREATE TABLE m_month (
    time TIMESTAMPTZ NOT NULL,
    device_id INT,
    val INT
) USING time_series WITH (
    ts_partition_column = 'time',
    ts_chunk_interval   = '7 day',
    ts_chunk_origin     = '2020-01-01'
) DISTRIBUTED BY (device_id);
INSERT INTO m_month
SELECT '2024-01-01 00:00+00'::timestamptz + (i * interval '5 day'),
       (i % 3) + 1, i
  FROM generate_series(0, 30) i;
ANALYZE m_month;
CREATE MATERIALIZED VIEW cv_month
WITH (time_series.continuous) AS
  SELECT time_bucket('1 month'::interval, time) AS bucket,
         device_id, count(*) AS cnt
    FROM m_month GROUP BY bucket, device_id;
NOTICE:  continuous aggregate "cv_month" successfully created
DETAIL:  Materialization table: time_series._mat_cv_month_5
CALL refresh_continuous_aggregate('cv_month',
       '2024-01-01 00:00+00'::timestamptz,
       '2024-03-01 00:00+00'::timestamptz);
NOTICE:  refreshing continuous aggregate "cv_month"
-- Walker should NOT push bare-time upper bound (month interval skipped).
DO $$
DECLARE
    plan TEXT := '';
    line TEXT;
    cur  REFCURSOR;
    has_bare_time_upper BOOLEAN := false;
BEGIN
    OPEN cur FOR
        EXPLAIN (COSTS off, TIMING off, ANALYZE off)
        SELECT * FROM cv_month
         WHERE bucket <= '2024-03-01 00:00+00'::timestamptz;
    LOOP
        FETCH cur INTO line;
        EXIT WHEN NOT FOUND;
        plan := plan || line || E'\n';
        IF line ~ '"time" <' THEN
            has_bare_time_upper := true;
        END IF;
    END LOOP;
    CLOSE cur;

    IF has_bare_time_upper THEN
        RAISE NOTICE 'MONTH-01 NOTE: month-interval upper bound was pushed';
    ELSE
        RAISE NOTICE 'MONTH-01 PASS: month-interval upper bound skipped (safe)';
    END IF;
END $$;
NOTICE:  MONTH-01 PASS: month-interval upper bound skipped (safe)
-- Correctness still holds: cv_month matches source aggregation.
WITH cv_rows AS (
    SELECT count(*) AS n, sum(cnt) AS c FROM cv_month
     WHERE bucket <= '2024-03-01 00:00+00'::timestamptz
), src_rows AS (
    SELECT count(*) AS n, sum(c) AS c FROM (
        SELECT time_bucket('1 month'::interval, time) AS bucket,
               device_id, count(*) AS c
          FROM m_month
         WHERE time_bucket('1 month'::interval, time) <= '2024-03-01 00:00+00'::timestamptz
         GROUP BY bucket, device_id
    ) s
)
SELECT (SELECT n FROM cv_rows) AS cv_n,
       (SELECT n FROM src_rows) AS src_n,
       (SELECT c FROM cv_rows) AS cv_c,
       (SELECT c FROM src_rows) AS src_c;
 cv_n | src_n | cv_c | src_c 
------+-------+------+-------
    9 |     9 |   19 |    19
(1 row)

