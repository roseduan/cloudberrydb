WITH cv_rows AS (
    SELECT count(*) AS n
      FROM cv
     WHERE bucket >= '2024-06-02 20:00+00'::timestamptz
        OR bucket >= '2024-06-03 06:00+00'::timestamptz
)
SELECT n AS cv_n FROM cv_rows;
