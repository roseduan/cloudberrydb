-- Self-join with same cagg twice — walker should handle both Var-Var aliases
-- ============================================================
-- DML-01: Non-SELECT statements skip the walker
--           (INSERT/UPDATE/DELETE on cv view is forbidden anyway
--            because cv is a UNION ALL view; but we want to confirm
--            walker doesn't error before the planner rejects.)
-- ============================================================
\echo '=== DML-01: non-SELECT skipped ==='
=== DML-01: non-SELECT skipped ===
\set ON_ERROR_STOP 0
INSERT INTO cv VALUES ('2099-01-01'::timestamptz, 1, 99, 99);
ERROR:  cannot insert into view "cv"
DETAIL:  Views containing UNION, INTERSECT, or EXCEPT are not automatically updatable.
HINT:  To enable inserting into the view, provide an INSTEAD OF INSERT trigger or an unconditional ON INSERT DO INSTEAD rule.
UPDATE cv SET cnt = 0 WHERE bucket >= '2024-06-02'::timestamptz;
ERROR:  cannot update view "cv"
DETAIL:  Views containing UNION, INTERSECT, or EXCEPT are not automatically updatable.
HINT:  To enable updating the view, provide an INSTEAD OF UPDATE trigger or an unconditional ON UPDATE DO INSTEAD rule.
DELETE FROM cv WHERE bucket >= '2024-06-02'::timestamptz;
ERROR:  cannot delete from view "cv"
DETAIL:  Views containing UNION, INTERSECT, or EXCEPT are not automatically updatable.
HINT:  To enable deleting from the view, provide an INSTEAD OF DELETE trigger or an unconditional ON DELETE DO INSTEAD rule.
\set ON_ERROR_STOP 1
-- ============================================================
-- PREP-01: PREPARE then EXECUTE — plan caching with watermark
-- ============================================================
\echo '=== PREP-01: prepared statement ==='
=== PREP-01: prepared statement ===
PREPARE p_cv (timestamptz) AS
    SELECT count(*) AS n, sum(cnt) AS c
      FROM cv WHERE bucket >= $1;
EXECUTE p_cv('2024-06-02 12:00+00'::timestamptz);
 n  | c  
----+----
 36 | 36
(1 row)

EXECUTE p_cv('2024-06-03 12:00+00'::timestamptz);
 n  | c  
----+----
 12 | 12
(1 row)

DEALLOCATE p_cv;
-- ============================================================
-- PLAN-03: Upper-bound predicate pushed onto ChunkScan
--
-- For `WHERE bucket <= C`, the walker should synthesize a strict
-- `time < (C + bucket_width)` predicate at the source-table level.
-- The plan should show a bare `"time" < ...` filter (the planner
-- will have const-folded the `+` to a single timestamp literal).
-- ============================================================
\echo '=== PLAN-03: upper-bound pushdown ==='
=== PLAN-03: upper-bound pushdown ===
DO $$
DECLARE
    plan TEXT := '';
    line TEXT;
    cur  REFCURSOR;
    has_bare_time_upper BOOLEAN := false;
BEGIN
    OPEN cur FOR
        EXPLAIN (COSTS off, TIMING off, ANALYZE off)
        SELECT * FROM cv
         WHERE bucket <= '2024-06-02 12:00+00'::timestamptz;
    LOOP
        FETCH cur INTO line;
        EXIT WHEN NOT FOUND;
        plan := plan || line || E'\n';
        IF line ~ '"time" <' THEN
            has_bare_time_upper := true;
        END IF;
    END LOOP;
    CLOSE cur;

    IF has_bare_time_upper THEN
        RAISE NOTICE 'PLAN-03 PASS: bare-time < predicate pushed to ChunkScan';
    ELSE
        RAISE NOTICE 'PLAN-03 FAIL: bare-time < NOT found in plan: %', plan;
    END IF;
END $$;
NOTICE:  PLAN-03 PASS: bare-time < predicate pushed to ChunkScan
-- ============================================================
-- CORR-10: Upper-bound correctness — `bucket <= X` cv vs source
-- ============================================================
\echo '=== CORR-10: upper-bound result equivalence ==='
=== CORR-10: upper-bound result equivalence ===
WITH cv_rows AS (
    SELECT bucket, device_id, cnt, s
      FROM cv
     WHERE bucket <= '2024-06-02 12:00+00'::timestamptz
), src_rows AS (
    SELECT time_bucket('1 hour'::interval, time) AS bucket,
           device_id,
           count(*) AS cnt,
           sum(val) AS s
      FROM m
     WHERE time_bucket('1 hour'::interval, time) <= '2024-06-02 12:00+00'::timestamptz
     GROUP BY bucket, device_id
)
SELECT
    (SELECT count(*) FROM cv_rows) AS cv_n,
    (SELECT count(*) FROM src_rows) AS src_n,
    (SELECT sum(cnt) FROM cv_rows) AS cv_cnt,
    (SELECT sum(cnt) FROM src_rows) AS src_cnt;
 cv_n | src_n | cv_cnt | src_cnt 
------+-------+--------+---------
   37 |    37 |     37 |      37
