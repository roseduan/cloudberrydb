-- ============================================================
-- Phase 7: Time range filter across mat/live boundary
--
-- Users commonly query CAGGs with WHERE bucket BETWEEN for
-- dashboards. This tests the UNION ALL view correctly merges
-- materialized and live data when the filter spans the watermark.
-- ============================================================
\echo '=== Phase 7: Time range filter ==='
=== Phase 7: Time range filter ===
-- Insert 10 rows beyond watermark (hours 22-23, not yet refreshed)
INSERT INTO sensor
SELECT '2024-01-01 00:00+00'::timestamptz
         + (hr || ' hour')::interval
         + (dev * 6 || ' minute')::interval,
       dev,
       20.0 + dev + hr * 0.1,
       50.0 + dev - hr * 0.1
FROM generate_series(1, 5) dev,
     generate_series(22, 23) hr;
-- Query spanning mat (< watermark ~17:00) and live (>= watermark)
\echo '--- A: EXCEPT = 0 across mat/live boundary ---'
--- A: EXCEPT = 0 across mat/live boundary ---
SELECT count(*) AS diff_range_filter FROM (
  (SELECT bucket, device_id, cnt,
          round(avg_temp::numeric, 10) AS avg_temp, min_hum, max_hum
   FROM sensor_hourly
   WHERE bucket >= '2024-01-01 15:00+00' AND bucket < '2024-01-02 01:00+00'
   EXCEPT
   SELECT time_bucket('1 hour'::interval, time), device_id, count(*),
          round(avg(temperature)::numeric, 10), min(humidity), max(humidity)
   FROM sensor
   WHERE time >= '2024-01-01 15:00+00' AND time < '2024-01-02 01:00+00'
   GROUP BY 1, 2)
  UNION ALL
  (SELECT time_bucket('1 hour'::interval, time), device_id, count(*),
          round(avg(temperature)::numeric, 10), min(humidity), max(humidity)
   FROM sensor
   WHERE time >= '2024-01-01 15:00+00' AND time < '2024-01-02 01:00+00'
   GROUP BY 1, 2
   EXCEPT
   SELECT bucket, device_id, cnt,
          round(avg_temp::numeric, 10), min_hum, max_hum
   FROM sensor_hourly
   WHERE bucket >= '2024-01-01 15:00+00' AND bucket < '2024-01-02 01:00+00')
) x;
 diff_range_filter 
-------------------
                 0
(1 row)

-- materialized_only should miss the live portion (hours >= 22)
\echo '--- B: materialized_only misses live data ---'
--- B: materialized_only misses live data ---
ALTER VIEW sensor_hourly SET (time_series.materialized_only = true);
SELECT count(*) AS mat_only_future
FROM sensor_hourly
WHERE bucket >= '2024-01-01 22:00+00';
 mat_only_future 
-----------------
               0
(1 row)

-- real-time mode sees all data including live portion
\echo '--- C: real-time mode sees live data ---'
--- C: real-time mode sees live data ---
ALTER VIEW sensor_hourly SET (time_series.materialized_only = false);
SELECT count(*) AS realtime_future
FROM sensor_hourly
WHERE bucket >= '2024-01-01 22:00+00';
 realtime_future 
