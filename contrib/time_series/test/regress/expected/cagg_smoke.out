-- ============================================================
-- Phase 8: Drop single CAGG
--
-- Drop sensor_daily while sensor_hourly and sensor_2hourly remain.
-- Verifies:
--   A. Dropped CAGG removed from catalog
--   B. Remaining CAGGs still queryable and correct
--   C. Source table trigger still works for remaining CAGGs
-- ============================================================
\echo '=== Phase 8: Drop single CAGG ==='
=== Phase 8: Drop single CAGG ===
DROP VIEW sensor_daily;
-- A. sensor_daily gone, others remain
\echo '--- A: catalog after drop ---'
--- A: catalog after drop ---
SELECT user_view_name FROM time_series.continuous_agg
WHERE user_view_name IN ('sensor_hourly', 'sensor_2hourly', 'sensor_daily')
ORDER BY user_view_name;
