=== POL-EDGE-12: schedule_interval = 0 + run_job — failure recorded, no crash ===
-- POL-EDGE-05 verified the policy DDL accepts schedule_interval=0.  This
-- pins what happens when run_job actually fires such a policy: the
-- internal time_bucket call rejects period=0, which bubbles into the
-- failure path; run_job must catch it and record a failed run rather
-- than crash the backend.
SELECT add_continuous_aggregate_policy('cv_tstz',
       '7 days'::interval, '0'::interval, '0'::interval) AS jid_zero \gset
\set VERBOSITY terse
\set ON_ERROR_STOP 0
CALL time_series.run_job(:jid_zero);
NOTICE:  refreshing continuous aggregate "cv_tstz"
NOTICE:  continuous aggregate "cv_tstz" is already up-to-date
ERROR:  period must be greater than 0
\set ON_ERROR_STOP 1
\set VERBOSITY default
SELECT total_runs > 0 AS run_attempted
  FROM time_series.bgw_job_stat WHERE job_id = :jid_zero;
