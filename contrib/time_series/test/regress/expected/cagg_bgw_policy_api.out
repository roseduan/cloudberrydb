-- ============================================================
-- BGW-DDL-12: DROP MATERIALIZED VIEW cascades to bgw_job/bgw_job_stat
--
-- When a CAGG is dropped while a refresh policy is still registered,
-- the associated bgw_job and bgw_job_stat rows must be cascade-
-- deleted via our sql_drop event trigger.  Otherwise an orphan job
-- would point at a non-existent cagg_id, and the scheduler would
-- dispatch it forever, generating a failure on each tick.
-- ============================================================
\echo '=== BGW-DDL-12: DROP MATERIALIZED VIEW cascades bgw_job rows ==='
=== BGW-DDL-12: DROP MATERIALIZED VIEW cascades bgw_job rows ===
CREATE TABLE m_drop_cascade (
    time TIMESTAMPTZ NOT NULL,
    tags_id INT NOT NULL,
    v INT
) USING time_series WITH (
    ts_partition_column = 'time',
    ts_chunk_interval   = '4 hour',
    ts_chunk_origin     = '2020-01-01'
) DISTRIBUTED BY (tags_id);
INSERT INTO m_drop_cascade
SELECT now() - (i * interval '5 minutes'), (i % 5) + 1, i
  FROM generate_series(1, 50) i;
CREATE MATERIALIZED VIEW cv_drop_cascade
WITH (time_series.continuous) AS
  SELECT time_bucket('1 hour'::interval, time) AS bucket,
         tags_id, count(*) AS c
    FROM m_drop_cascade GROUP BY bucket, tags_id;
NOTICE:  continuous aggregate "cv_drop_cascade" successfully created
DETAIL:  Materialization table: time_series._mat_cv_drop_cascade_4
SELECT add_continuous_aggregate_policy('cv_drop_cascade',
       '7 days'::interval, '0'::interval, '1 hour'::interval)
  AS jid_drop_cascade \gset
SELECT count(*) AS job_rows_before_drop
  FROM time_series.bgw_job WHERE id = :jid_drop_cascade;
 job_rows_before_drop 
----------------------
                    1
(1 row)

DROP VIEW cv_drop_cascade;
SELECT count(*) AS job_rows_after_drop
  FROM time_series.bgw_job WHERE id = :jid_drop_cascade;
 job_rows_after_drop 
---------------------
                   0
(1 row)

SELECT count(*) AS stat_rows_after_drop
  FROM time_series.bgw_job_stat WHERE job_id = :jid_drop_cascade;
 stat_rows_after_drop 
----------------------
                    1
(1 row)

-- Belt-and-suspenders: if the DROP left an orphan (would indicate a
-- regression of the sql_drop trigger), remove it explicitly so it
-- does not pollute subsequent scheduler dispatches.
DELETE FROM time_series.bgw_job WHERE id = :jid_drop_cascade;
DROP TABLE m_drop_cascade;
