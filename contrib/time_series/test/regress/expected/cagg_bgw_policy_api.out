-- ============================================================
-- cagg_bgw_policy_api.sql
--
-- CAGG policy API matrix (no refresh execution, no multi-user).
--
-- Sections:
--   1. DDL validation: add_continuous_aggregate_policy /
--      remove_continuous_aggregate_policy parameter handling
--   2. cagg_policy_stats view content (BGW-VIEW-01/02 only;
--      multi-user filtering -> cagg_bgw_policy_permissions.sql)
--   3. BGW lifecycle catalog effects (remove + DROP cagg)
--   4. policy_refresh_cagg manual entry validation
--   5. Lifecycle stress (idempotence, multi-cagg)
--   6. View column coverage
--   7. Edge cases (extreme/null intervals, naming)
--   8. bgw_job catalog field assertions
--   9. cagg_policy_stats consistency
--  10. Schema-qualified / case-folded cagg_name handling
--  11. alter_job
--
-- Sibling files:
--   * cagg_bgw_policy_run.sql         - synchronous refresh trigger
--   * cagg_bgw_policy_permissions.sql - multi-user permission tests
--   * cagg_bgw_policy_mock_time.sql   - mock-time scheduler dispatch
--   * cagg_bgw_policy_e2e.sql         - real BGW worker dispatch
-- ============================================================
SET optimizer = off;
SET timezone = 'UTC';
DROP EXTENSION IF EXISTS time_series CASCADE;
NOTICE:  extension "time_series" does not exist, skipping
-- Defensive: prior test runs may leave behind source tables and auto-named
-- materialization tables (which are NOT cleaned by DROP EXTENSION CASCADE
-- for views that were dropped via DROP MATERIALIZED VIEW).
DROP TABLE IF EXISTS metrics_tstz CASCADE;
NOTICE:  table "metrics_tstz" does not exist, skipping
DROP TABLE IF EXISTS metrics_ts   CASCADE;
NOTICE:  table "metrics_ts" does not exist, skipping
DROP TABLE IF EXISTS metrics_date CASCADE;
NOTICE:  table "metrics_date" does not exist, skipping
CREATE EXTENSION time_series;
WARNING:  referential integrity (FOREIGN KEY) constraints are not supported in Apache Cloudberry, will not be enforced
-- This is a pure API-matrix test: no refresh execution intended.
-- With the scheduler live, add_continuous_aggregate_policy() can be
-- dispatched within milliseconds and race against assertions that
-- inspect the "not yet fired" state (POL-VIEW-03 in particular).
-- Stop the scheduler so all catalog assertions read a stable state.
SELECT time_series.stop_background_workers();
 stop_background_workers 
-------------------------
 t
(1 row)

SET search_path TO public, time_series;
-- ============================================================
-- Setup: source tables with data placed relative to now()
-- so that policy default windows (now()-Xd, now()] actually cover them.
-- ============================================================
CREATE TABLE metrics_tstz (
    time        TIMESTAMPTZ       NOT NULL,
    tags_id     INT               NOT NULL,
    temperature DOUBLE PRECISION
) USING time_series WITH (
    ts_partition_column = 'time',
    ts_chunk_interval   = '4 hour',
    ts_chunk_origin     = '2020-01-01'
) DISTRIBUTED BY (tags_id);
-- 48 hours of data ending ~2 hours before now(), so refresh windows that
-- exclude the most-recent few minutes still cover the last bucket.
INSERT INTO metrics_tstz
SELECT date_trunc('hour', now()) - ((48 - h) * interval '1 hour')
       + (m * interval '5 minutes'),
       (h % 5) + 1,
       20.0 + h * 0.1 + m * 0.01
FROM generate_series(1, 48) h,
     generate_series(0, 5)  m;
CREATE TABLE metrics_ts (
    time        TIMESTAMP         NOT NULL,
    tags_id     INT               NOT NULL,
    temperature DOUBLE PRECISION
) USING time_series WITH (
    ts_partition_column = 'time',
    ts_chunk_interval   = '4 hour',
    ts_chunk_origin     = '2020-01-01'
) DISTRIBUTED BY (tags_id);
INSERT INTO metrics_ts
SELECT (date_trunc('hour', now()) - ((48 - h) * interval '1 hour'))::timestamp,
       (h % 5) + 1, 20.0 + h * 0.1
FROM generate_series(1, 48) h;
CREATE TABLE metrics_date (
    time        DATE              NOT NULL,
    tags_id     INT               NOT NULL,
    cnt         INT
) USING time_series WITH (
    ts_partition_column = 'time',
    ts_chunk_interval   = '4 hour',
    ts_chunk_origin     = '2020-01-01'
) DISTRIBUTED BY (tags_id);
INSERT INTO metrics_date
SELECT (now()::date - d), (d % 5) + 1, d * 10
FROM generate_series(1, 10) d;
-- ============================================================
-- CAGG views
-- ============================================================
CREATE MATERIALIZED VIEW cv_tstz
WITH (time_series.continuous) AS
  SELECT time_bucket('1 hour'::interval, time) AS bucket, tags_id,
         count(*) AS cnt, avg(temperature) AS avg_temp
  FROM metrics_tstz GROUP BY bucket, tags_id;
NOTICE:  continuous aggregate "cv_tstz" successfully created
DETAIL:  Materialization table: time_series._mat_cv_tstz_1
CREATE MATERIALIZED VIEW cv_ts
WITH (time_series.continuous) AS
  SELECT time_bucket('1 hour'::interval, time) AS bucket, tags_id,
         count(*) AS cnt
  FROM metrics_ts GROUP BY bucket, tags_id;
NOTICE:  continuous aggregate "cv_ts" successfully created
DETAIL:  Materialization table: time_series._mat_cv_ts_2
CREATE MATERIALIZED VIEW cv_date
WITH (time_series.continuous) AS
  SELECT time_bucket('1 day'::interval, time) AS bucket, tags_id,
         sum(cnt) AS s
  FROM metrics_date GROUP BY bucket, tags_id;
NOTICE:  continuous aggregate "cv_date" successfully created
DETAIL:  Materialization table: time_series._mat_cv_date_3
