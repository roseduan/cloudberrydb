-- ============================================================
\echo '=== TEST-02: CREATE EXTENSION in new DB → scheduler auto-spawn ==='
=== TEST-02: CREATE EXTENSION in new DB → scheduler auto-spawn ===
CREATE DATABASE bgw_launcher_db2;
\c bgw_launcher_db2
SET client_min_messages = WARNING;
CREATE EXTENSION time_series;
WARNING:  referential integrity (FOREIGN KEY) constraints are not supported in Apache Cloudberry, will not be enforced
\c contrib_regression
SET client_min_messages = WARNING;
SELECT wait_worker_counts(1, 1, 0) AS test_02_ok;
