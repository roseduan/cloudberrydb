-- ============================================================
-- BGW-FULL-FIXED-GRID: fixed_schedule anchors next_start to grid
--
-- Contract: when bgw_job.fixed_schedule = true, the scheduler must
-- compute next_start as
--     initial_start + ceil((now - initial_start) / schedule_interval)
--                     * schedule_interval
-- i.e., aligned to a grid of initial_start + N*schedule_interval
-- regardless of when the previous tick actually completed.
--
-- Drifting-schedule (fixed_schedule = false) computes
--     next_start = last_finish + schedule_interval
-- which drifts by the refresh execution time on every tick.
--
-- Production impact if fixed_schedule were silently treated as
-- drifting: cagg materialization would slip later every cycle,
-- monthly time-zone-aware reports show data missing the latest
-- hour, etc.  Operator-facing bug, hard to detect without exact
-- timing tests.
--
-- Test uses a synthetic add_job() with a no-op procedure so the
-- fixed_schedule mechanism is exercised at the SCHEDULER tier,
-- independent of cagg refresh complications.  Assertion:
--     (next_start - initial_start) is an exact multiple of
--     schedule_interval, i.e., the modulus is 0.
-- ============================================================
\echo '=== BGW-FULL-FIXED-GRID: fixed_schedule next_start aligns to grid ==='
=== BGW-FULL-FIXED-GRID: fixed_schedule next_start aligns to grid ===
CREATE PROCEDURE noop_grid_test(jid int, cfg jsonb) LANGUAGE plpgsql AS $$
BEGIN END$$;
-- initial_start anchored at a deterministic past instant on the hour.
-- schedule_interval = 1 hour means valid grid points are 12:00, 13:00, ...
SELECT add_job('noop_grid_test'::regproc,
               '1 hour'::interval,
               initial_start => '2024-01-03 12:00:00+00'::timestamptz) AS jid_grid \gset
-- Verify the catalog row captured initial_start + fixed_schedule=true.
SELECT initial_start = '2024-01-03 12:00:00+00'::timestamptz AS initial_start_set,
       fixed_schedule                                        AS fixed_schedule_on
  FROM time_series.bgw_job WHERE id = :jid_grid;
