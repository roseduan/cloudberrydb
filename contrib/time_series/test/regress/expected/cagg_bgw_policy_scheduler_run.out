-- BGW-FULL-NEXT-START: alter_job(next_start => ...) brings the
--   next dispatch forward — operator's "fire this job NOW" tool.
--
-- Mirrors ("change next run to be
-- after 30s instead").  Real-world: DBA needs to force an immediate
-- backfill without waiting for schedule_interval to elapse, e.g.
-- after a data correction or to catch up after the cluster was down.
--
-- Pre-state from BGW-FULL-07: next_start = '2099-01-01' (far future).
-- We override to a past mock time, advance clock, run scheduler,
-- and verify the tick fires DESPITE schedule_interval not having
-- elapsed since the previous run.
-- ============================================================
\echo '=== BGW-FULL-NEXT-START: alter_job(next_start) triggers immediate dispatch ==='
=== BGW-FULL-NEXT-START: alter_job(next_start) triggers immediate dispatch ===
SELECT total_runs AS runs_before_nextstart_override
  FROM time_series.bgw_job_stat WHERE job_id = :jid \gset
-- Move next_start to a moment shortly before the mock clock we set below.
-- alter_job returns bgw_job (catalog table) — next_start lives in
-- bgw_job_stat, so we verify the side effect separately.
SELECT (alter_job(:jid, next_start => '2024-01-03 11:00:00+00'::timestamptz)).id
       IS NOT NULL AS next_start_altered;
