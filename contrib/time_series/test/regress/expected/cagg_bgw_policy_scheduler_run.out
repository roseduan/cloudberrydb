-- Cleanup.  Reaching this line is the pass signal — a worker SIGSEGV
-- would have hung the test long enough for pg_regress's timeout to fire.
SELECT remove_continuous_aggregate_policy('cv_full_mat_only');
 remove_continuous_aggregate_policy 
