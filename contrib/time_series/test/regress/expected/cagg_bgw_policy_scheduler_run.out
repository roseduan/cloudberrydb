SELECT :jid_grid, '2024-01-03 14:00:00+00'::timestamptz
 WHERE NOT EXISTS (SELECT 1 FROM time_series.bgw_job_stat WHERE job_id = :jid_grid);
SELECT time_series.bgw_db_scheduler_test_run_and_wait_for_scheduler_finish(60000);
