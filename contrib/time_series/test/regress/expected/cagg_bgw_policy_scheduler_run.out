-- ============================================================
-- cagg_bgw_policy_scheduler_run.sql
--
-- Scheduler-driven runs of CAGG refresh policies.  Same test target
-- as cagg_bgw_policy_run.sql (synchronous CALL run_job), but exercised
-- via the BGW scheduler's dispatch loop under a virtual mock clock
-- so failure / retry / max_retries / backoff state machines can be
-- driven deterministically across many ticks within wall-clock
-- microseconds (real-BGW versions of these would take minutes and
-- would flake).
--
-- Adapted from upstream
--.
--
-- Differences vs upstream (V1 architecture / CBDB):
--   - schemas: upstream config / internal / catalog schemas
--     → time_series
--   - integer time column + create_hypertable + set_integer_now_func
--     → timestamptz column + plain DISTRIBUTED BY (no hypertable concept)
--   - the cagg+materialized_only options
--     → time_series.continuous / time_series.materialized_only=true
--   - the mock-time clock setter
--     → bgw_params_reset_time() from our mock_time framework
--   - test.wait_for_job_to_run helper
--     → wait_for_runs() local plpgsql helper
--   - Multi-role permission tests skipped (V1 doesn't have ROLE_*
--     infrastructure baked in).
--
-- Total mock-time ticks used: ~10
-- ============================================================
SET optimizer = off;
SET timezone = 'UTC';
DROP EXTENSION IF EXISTS time_series CASCADE;
NOTICE:  extension "time_series" does not exist, skipping
DROP TABLE IF EXISTS public.bgw_log CASCADE;
NOTICE:  table "bgw_log" does not exist, skipping
DROP TABLE IF EXISTS public.bgw_dsm_handle_store CASCADE;
NOTICE:  table "bgw_dsm_handle_store" does not exist, skipping
DROP TABLE IF EXISTS m_full CASCADE;
NOTICE:  table "m_full" does not exist, skipping
CREATE EXTENSION time_series;
WARNING:  referential integrity (FOREIGN KEY) constraints are not supported in Apache Cloudberry, will not be enforced
SET search_path TO public, time_series;
-- The launcher auto-spawns a real (wall-clock) scheduler in every DB
-- that has time_series installed.  In a mock-time test we need
-- exclusive ownership of bgw_job so the mock dispatcher's deterministic
-- ticks aren't observed concurrently with a wall-clock scheduler.
--
-- stop_background_workers() sends BGW_MSG_STOP to the launcher, which
-- terminates the scheduler and lands its per-DB entry in DISABLED.  The
-- launcher's automatic poll loop ignores DISABLED entries so no respawn
-- happens; the matching start_background_workers() appears at the end.
SELECT time_series.stop_background_workers();
 stop_background_workers 
-------------------------
 t
(1 row)

-- ============================================================
-- mock_time framework setup (1:1 with  L51-70)
-- ============================================================
CREATE TABLE public.bgw_log(
    msg_no INT,
    mock_time BIGINT,
    application_name TEXT,
    msg TEXT
) DISTRIBUTED REPLICATED;
CREATE VIEW public.sorted_bgw_log AS
    SELECT msg_no, mock_time, application_name,
           regexp_replace(
               regexp_replace(msg,
                   '(Wait until|started at|execution time) [0-9]+(\.[0-9]+)?',
                   '\1 (RANDOM)', 'g'),
               'background worker "[^"]+"', 'connection') AS msg
      FROM public.bgw_log
     ORDER BY mock_time, application_name COLLATE "C", msg_no;
CREATE TABLE public.bgw_dsm_handle_store(handle BIGINT) DISTRIBUTED REPLICATED;
INSERT INTO public.bgw_dsm_handle_store VALUES (0);
SELECT time_series.bgw_params_create();
 bgw_params_create 
-------------------
 
(1 row)

-- ============================================================
-- Helper: wait_for_quiesce(p_jobs, p_spins)
--
-- bgw_db_scheduler_test_run_and_wait_for_scheduler_finish only joins on
-- the scheduler process; worker processes commit mark_end asynchronously
-- (mark_start runs in worker → total_runs++ → COMMIT; later mark_end
-- runs in same worker → total_successes/total_failures++ → COMMIT).
-- A snapshot taken immediately after scheduler_finish may therefore see
-- total_runs incremented but total_successes/total_failures lagging.
--
-- Used at sites where the test wants to assert a final per-job tally and
-- multiple workers are concurrent enough that the race is observable
-- (notably BGW-FULL-MULTI-JOB with 3 workers in flight).  The invariant
-- enforced is the obvious one: every started run eventually finalizes as
-- exactly one of success or failure, so
--     total_runs == total_successes + total_failures
-- for every job in the watched set.
-- ============================================================
-- p_spins default bumped from 50 (5 sec at 0.1s per spin) to 300
-- (30 sec) for back-to-back CI runs where BGW worker dispatch and
-- mock-clock scheduler-tick handling can lag under heavy load.
CREATE FUNCTION wait_for_quiesce(p_jobs int[], p_spins int DEFAULT 300)
RETURNS bool LANGUAGE plpgsql AS $$
DECLARE q bool;
BEGIN
  FOR i IN 1..p_spins LOOP
    SELECT bool_and(total_runs = total_successes + total_failures)
      INTO q
      FROM time_series.bgw_job_stat
     WHERE job_id = ANY(p_jobs);
    IF q THEN RETURN true; END IF;
    PERFORM pg_sleep(0.1);
  END LOOP;
  RETURN false;
END $$;
-- ============================================================
-- Source table + CAGG ( L78-92, adapted)
-- ============================================================
CREATE TABLE m_full (
    time TIMESTAMPTZ NOT NULL,
    tags_id INT NOT NULL,
    v INT
) USING time_series WITH (
    ts_partition_column = 'time',
    ts_chunk_interval   = '4 hour',
    ts_chunk_origin     = '2020-01-01'
) DISTRIBUTED BY (tags_id);
-- 24 hours of synthetic data anchored at REAL now().  We deliberately
-- do NOT anchor at the mock clock origin (2024-01-01), because the
-- BGW worker computes its refresh window from `now()` (= transaction
-- start time, real time), not from the mocked clock — only mock_wait
-- is intercepted, not now().  So source data lives in real-time and
-- the window catches it.  The mock clock still drives scheduler tick
-- timing and bgw_log timestamps.
INSERT INTO m_full
SELECT now() - (h * interval '1 hour'), (h % 5) + 1, h
FROM generate_series(1, 24) h;
-- ============================================================
-- BGW-FULL-CHUNK-COUNT: 24h data × 4h chunk_interval → ≥ 6 chunks
--
-- Sanity floor: assertions later in this file (BGW-FULL-MERGE-FORCE
-- in particular) assume the data is spread across multiple chunks for
-- merged-refresh behavior to be meaningful.  If chunk creation
-- regressed (e.g., all rows landed in one chunk due to a partition-
-- bound bug), every downstream chunk-aware claim becomes ambiguous
-- about whether the SCHEDULER did its job or the data layout silently
-- collapsed.  Pin the floor here.
--
-- ≥ 6 rather than = 6 because chunk boundaries are aligned to the
-- 2020-01-01 origin at 4h granularity; depending on where wall-clock
-- now() falls relative to that grid, 24h of data crosses 6 or 7
-- chunks.  Either way is multi-chunk and adequate for downstream
-- tests; a regression that lands everything in 1-2 chunks fails.
-- ============================================================
SELECT count(*) >= 6 AS m_full_at_least_6_chunks
  FROM time_series.ts_chunk WHERE table_oid = 'm_full'::regclass;
 m_full_at_least_6_chunks 
--------------------------
 t
(1 row)

-- materialized_only is intentionally LEFT DEFAULT (false).  Reasons:
--  1. With true, view only shows mat-table data; we'd need the worker
--     to actually populate the mat table to see anything.
--  2. With default (false), the view is a UNION ALL of mat + raw
--     aggregation, so our assertions about source-data-derived
--     aggregates (s > 1000 etc.) reflect the full picture.
CREATE MATERIALIZED VIEW cv_full
WITH (time_series.continuous) AS
  SELECT time_bucket('1 hour'::interval, time) AS bucket,
         tags_id, count(*) AS c, sum(v) AS s
  FROM m_full GROUP BY bucket, tags_id;
NOTICE:  continuous aggregate "cv_full" successfully created
DETAIL:  Materialization table: time_series._mat_cv_full_1
SELECT add_continuous_aggregate_policy('cv_full',
       '7 days'::interval, '0'::interval, '12 hours'::interval) AS jid \gset
