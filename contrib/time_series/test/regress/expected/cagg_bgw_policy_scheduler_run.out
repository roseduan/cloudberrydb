-- ============================================================
-- BGW-FULL-MERGE-FORCE: time_series.materializations_per_refresh_window
--   forces / inhibits invalidation merging.
--
-- Mirrors (ALTER SYSTEM SET ... = 0).
-- Real-world: when many sparse invalidations accumulate (UPDATE many
-- non-contiguous rows), default behavior is to refresh each disjoint
-- range separately; setting the GUC to 0 forces them into ONE merged
-- refresh — operator's knob to trade I/O concentration vs CPU spike.
--
-- Test: set GUC = 0, scatter UPDATEs across 5 disjoint hour buckets,
-- run scheduler once, verify all 5 buckets show the updated values
-- AND total_runs incremented by exactly 1 (one merged refresh, not 5).
-- ============================================================
\echo '=== BGW-FULL-MERGE-FORCE: GUC=0 forces a single merged refresh ==='
=== BGW-FULL-MERGE-FORCE: GUC=0 forces a single merged refresh ===
SET time_series.materializations_per_refresh_window = 0;
SELECT total_runs AS runs_before_merge_force
  FROM time_series.bgw_job_stat WHERE job_id = :jid \gset
-- Scatter INSERTs across 4 disjoint hour buckets for tags_id = 1.
-- (Originally UPDATE m_full SET v = v + 100000 WHERE tags_id = 1;
-- rewritten because hypertable is append-only.  Same intent: dirty
-- exactly 4 distinct hour buckets where tags_id=1 has data.  Each
-- new row contributes v=200000, pushing each affected bucket's
-- sum(v) > 100000.)
INSERT INTO m_full
SELECT now() - (h * interval '1 hour'), 1, 200000
FROM unnest(ARRAY[5, 10, 15, 20]) AS h;
-- Force the next scheduler tick.
UPDATE time_series.bgw_job_stat
   SET next_start = '2024-01-03 11:00:00+00'::timestamptz
 WHERE job_id = :jid;
SELECT time_series.bgw_params_reset_time(
    extract(epoch from '2024-01-04 00:00:00+00'::timestamptz)::bigint * 1000000,
    false);
 bgw_params_reset_time 
-----------------------
 
(1 row)

SELECT time_series.bgw_db_scheduler_test_run_and_wait_for_scheduler_finish(60000);
 bgw_db_scheduler_test_run_and_wait_for_scheduler_finish 
---------------------------------------------------------
 
(1 row)

-- Exactly one new successful run (merged refresh, not N per dirty range).
SELECT total_runs = :runs_before_merge_force + 1   AS exactly_one_merged_run,
