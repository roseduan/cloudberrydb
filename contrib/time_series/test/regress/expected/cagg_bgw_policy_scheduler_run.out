DROP PROCEDURE noop_maxr_fail(int, jsonb);
-- ============================================================
-- BGW-FULL-MULTI-JOB: scheduler dispatches all eligible jobs in one tick
--
-- Contract: when N jobs are eligible at the same tick (next_start
-- in the past), the scheduler must iterate the bgw_job table and
-- dispatch ALL of them (subject to bgw_max_workers concurrency
-- cap — default 4 in V1, see scheduler.c:reserve_worker).  This is
-- the core "fairness" guarantee for multi-policy clusters.
--
-- Production impact if iteration broke:
--   - Scheduler picks first eligible only → other policies starve
--     forever, their caggs never refresh.
--   - Scheduler skips on per-job error → one bad config breaks the
--     entire cluster's refresh pipeline.
--
-- This test uses 3 trivial noop jobs (well under the 4-worker cap)
-- so all three must fire in the SAME synchronous scheduler tick.
-- ============================================================
\echo '=== BGW-FULL-MULTI-JOB: scheduler dispatches all eligible jobs in one tick ==='
=== BGW-FULL-MULTI-JOB: scheduler dispatches all eligible jobs in one tick ===
-- The per-DB scheduler suppression set at the top of this file
-- (stop_background_workers()) already prevents any real scheduler
-- from running in this DB, so no additional backend termination is
-- required here.
CREATE PROCEDURE noop_multi(jid int, cfg jsonb) LANGUAGE plpgsql AS $$
BEGIN END$$;
SELECT add_job('noop_multi'::regproc, '1 hour'::interval) AS jid_m1 \gset
SELECT add_job('noop_multi'::regproc, '1 hour'::interval) AS jid_m2 \gset
SELECT add_job('noop_multi'::regproc, '1 hour'::interval) AS jid_m3 \gset
-- Make all three eligible (next_start in the past relative to the
-- mock clock we set below).  Use UPDATE-then-INSERT-IF-NOT-EXISTS
-- so the bgw_job_stat row is guaranteed present without depending
-- on whether mark_start ran already.
UPDATE time_series.bgw_job_stat
   SET next_start = '2024-01-07 11:00:00+00'::timestamptz
 WHERE job_id IN (:jid_m1, :jid_m2, :jid_m3);
INSERT INTO time_series.bgw_job_stat (job_id, next_start)
SELECT v, '2024-01-07 11:00:00+00'::timestamptz
  FROM (VALUES (:jid_m1), (:jid_m2), (:jid_m3)) AS t(v)
 WHERE NOT EXISTS (
    SELECT 1 FROM time_series.bgw_job_stat s WHERE s.job_id = t.v);
SELECT time_series.bgw_params_reset_time(
    extract(epoch from '2024-01-07 12:00:00+00'::timestamptz)::bigint * 1000000,
    false);
 bgw_params_reset_time 
-----------------------
 
(1 row)

SELECT time_series.bgw_db_scheduler_test_run_and_wait_for_scheduler_finish(60000);
 bgw_db_scheduler_test_run_and_wait_for_scheduler_finish 
---------------------------------------------------------
 
(1 row)

-- Wait for the 3 workers' mark_end commits to be visible before
-- snapshotting bgw_job_stat (see wait_for_quiesce header for why).
SELECT wait_for_quiesce(ARRAY[:jid_m1, :jid_m2, :jid_m3]) AS multi_quiesced;
 multi_quiesced 
----------------
 t
(1 row)

-- All 3 jobs must have at least one successful run.  Any value < 3
-- here would indicate the scheduler's iteration broke or worker
-- reservation lost a slot.
SELECT count(*) FILTER (WHERE total_runs >= 1) = 3       AS all_three_fired,
       count(*) FILTER (WHERE total_successes >= 1) = 3  AS all_three_succeeded,
       count(*) FILTER (WHERE total_failures > 0) = 0    AS no_failures
  FROM time_series.bgw_job_stat
 WHERE job_id IN (:jid_m1, :jid_m2, :jid_m3);
 all_three_fired | all_three_succeeded | no_failures 
-----------------+---------------------+-------------
 t               | t                   | t
(1 row)

-- Cleanup
SELECT delete_job(:jid_m1);
 delete_job 
------------
 
(1 row)

SELECT delete_job(:jid_m2);
 delete_job 
------------
 
(1 row)

SELECT delete_job(:jid_m3);
 delete_job 
------------
 
(1 row)

DROP PROCEDURE noop_multi(int, jsonb);
-- ============================================================
-- BGW-FULL-FAIL: failure-path coverage (deterministic via mock scheduler)
--
-- e2e tests cover the happy path under real BGW timing.  Failure
-- paths need determinism (no timing flake) and run faster under
-- the mock scheduler, so they live here.
--
-- Setup: fail_switch table acts as a global toggle; fail_marker()
-- function reads it and raises when enabled=true.  The cv_fail_mock
-- cagg embeds fail_marker() in its SELECT expression as a poison
-- pill — toggling enabled flips the next refresh between success
-- and failure deterministically.
--
-- IMMUTABLE marker on fail_marker() is technically dishonest (body
-- reads a table) but cagg validation requires it for SELECT-list
-- expressions.  plpgsql bodies aren't inlined and there's no cross-
-- refresh result cache, so toggling fail_switch.enabled between
-- refreshes is observed correctly.
-- ============================================================
\echo '=== BGW-FULL-FAIL setup: fail-injection helpers + dedicated cagg ==='
=== BGW-FULL-FAIL setup: fail-injection helpers + dedicated cagg ===
CREATE TABLE fail_switch (singleton bool PRIMARY KEY DEFAULT true,
                          enabled   bool NOT NULL DEFAULT false)
  DISTRIBUTED REPLICATED;
INSERT INTO fail_switch (singleton, enabled) VALUES (true, false);
CREATE OR REPLACE FUNCTION fail_marker() RETURNS int
LANGUAGE plpgsql IMMUTABLE AS $$
DECLARE en bool;
BEGIN
    SELECT enabled INTO en FROM fail_switch;
    IF en THEN
        RAISE EXCEPTION 'simulated refresh failure'
              USING ERRCODE = 'raise_exception';
    END IF;
    RETURN 0;
END;
$$;
CREATE TABLE m_fail_mock (time TIMESTAMPTZ NOT NULL,
                          tags_id INT NOT NULL,
                          v INT) USING time_series WITH (
    ts_partition_column = 'time',
    ts_chunk_interval   = '4 hour',
    ts_chunk_origin     = '2020-01-01'
) DISTRIBUTED BY (tags_id);
-- Anchor the source data in the MOCK clock era (2024), not real now().
-- The BGW scheduler computes the policy refresh window from the mock
-- clock (timer_get_current_timestamp -> mock_current_time), so the
-- window for these FAIL tests is ~[2023-12-28, 2024-01-05].  Anchoring
-- the 24 hourly rows at 2024-01-03 puts them inside that window, so a
-- policy refresh genuinely processes them (necessary for FAIL-02 to
-- exercise the failure path -- fail_marker() only fires when the
-- partial view actually aggregates a bucket).  (Pre-fix this used
-- now(); that worked by accident only because the mock-clock epoch bug
-- pushed the window ~30 years into the future and the partial view was
-- evaluated for its side effect before the window filter discarded the
-- rows.  See the mock_current_time() fix in timer_mock.c.)
INSERT INTO m_fail_mock
SELECT '2024-01-03 12:00:00+00'::timestamptz - (h * interval '1 hour'),
       (h % 5) + 1, h
  FROM generate_series(1, 24) h;
CREATE MATERIALIZED VIEW cv_fail_mock
WITH (time_series.continuous) AS
  SELECT time_bucket('1 hour'::interval, time) AS bucket,
         tags_id,
         count(*) + fail_marker() AS c
    FROM m_fail_mock GROUP BY bucket, tags_id;
NOTICE:  continuous aggregate "cv_fail_mock" successfully created
DETAIL:  Materialization table: time_series._mat_cv_fail_mock_2
SELECT add_continuous_aggregate_policy('cv_fail_mock',
       '7 days'::interval, '0'::interval, '12 hours'::interval) AS jid_fail \gset
-- ============================================================
-- BGW-FULL-FAIL-01: baseline success while fail_switch=false
-- ============================================================
\echo '=== BGW-FULL-FAIL-01: baseline success before injection ==='
=== BGW-FULL-FAIL-01: baseline success before injection ===
SELECT time_series.bgw_params_reset_time(
    extract(epoch from '2024-01-04 00:00:00+00'::timestamptz)::bigint * 1000000,
    false);
 bgw_params_reset_time 
-----------------------
 
(1 row)

SELECT time_series.bgw_params_mock_wait_returns_immediately(1);
 bgw_params_mock_wait_returns_immediately 
------------------------------------------
 
(1 row)

UPDATE time_series.bgw_job_stat
   SET next_start = '2024-01-03 23:00:00+00'::timestamptz
 WHERE job_id = :jid_fail;
SELECT time_series.bgw_db_scheduler_test_run_and_wait_for_scheduler_finish(60000);
 bgw_db_scheduler_test_run_and_wait_for_scheduler_finish 
---------------------------------------------------------
 
(1 row)

SELECT total_runs >= 1      AS at_least_one_run,
       total_successes >= 1 AS at_least_one_success,
       total_failures = 0   AS no_failures_yet,
       last_run_success     AS last_ok
  FROM time_series.bgw_job_stat WHERE job_id = :jid_fail;
 at_least_one_run | at_least_one_success | no_failures_yet | last_ok 
------------------+----------------------+-----------------+---------
 t                | t                    | t               | t
(1 row)

-- ============================================================
-- BGW-FULL-FAIL-02: refresh failure bumps counters + history
--
-- Verifies the BGW worker's failure-capture path:
--   * total_failures, consecutive_failures advance
--   * last_run_success = false, last_successful_finish < last_finish
--   * bgw_job_stat_history INSERT with succeeded=false
--   * data->'error_data' populated through errdata_to_jsonb()
--     with sqlerrcode and the original RAISE message preserved
--
-- To fire fail_marker() the policy refresh must actually aggregate a
-- bucket.  Post hot-bucket-exclusion fix a refresh only does real
-- work when there is a dirty STABLE bucket, so we backfill one into
-- an already-materialised bucket: that writes an L1 invalidation,
-- the BGW worker's refresh re-aggregates the bucket via the partial
-- view (count(*)+fail_marker()), and fail_marker() RAISEs.  The
-- backfill is anchored in the mock-clock era (2024) so it lands
-- inside the policy window the scheduler computes from the mock
-- clock.  (Pre-fix this test fired only by accident: a mock-clock
-- epoch bug pushed the window ~30 years out and the partial view was
-- evaluated for its side effect before the window filter discarded
-- the rows.  Both the epoch bug -- see timer_mock.c -- and the source
-- anchoring are now fixed.)
-- ============================================================
\echo '=== BGW-FULL-FAIL-02: failure counters + error_data captured ==='
=== BGW-FULL-FAIL-02: failure counters + error_data captured ===
UPDATE fail_switch SET enabled = true;
-- Fresh insert above the current hot bucket (11:00) so the mock-clock
-- refresh advances the watermark past 11:00.  The 11:00 bucket then
-- transitions from hot → stable and gets pulled into the refresh
-- window via watermark-advance rather than via the hypertable L1
-- invalidation trigger.  On CI the L1 trigger's PRE_COMMIT flush
-- timing didn't fire (invalidation_log stayed empty and refresh
