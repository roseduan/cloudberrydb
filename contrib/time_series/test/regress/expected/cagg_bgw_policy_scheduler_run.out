DROP PROCEDURE noop_grid_test(int, jsonb);
-- ============================================================
-- BGW-FULL-RETRY-BACKOFF: failed job retries on retry_period, not
--   on schedule_interval
--
-- Contract: when a job FAILS, the scheduler computes next_start
-- using bgw_job.retry_period (short, typically seconds to a few
-- minutes) so transient errors recover quickly, NOT using
-- schedule_interval (typically hours or days).  V1 implements
-- exponential backoff capped at 20×: next_start = last_finish +
-- retry_period × min(consecutive_failures, 20).
--
-- Production impact if retry_period were ignored and the scheduler
-- fell back to schedule_interval:
--   - Transient network blip during cagg refresh → next refresh
--     not until the next schedule tick (could be hours), users
--     read stale data for the gap.
--   - Cumulative effect of many flaky caggs all moved to long
--     intervals: cluster looks "fine" but freshness silently
--     degraded.
--
-- Test design: schedule_interval = 1 hour vs retry_period = 30 s.
-- After a failure, observed (next_start - last_finish) should be in
-- the seconds-to-minutes range from retry_period × N, not ~1 hour
-- from schedule_interval.
-- ============================================================
\echo '=== BGW-FULL-RETRY-BACKOFF: retry uses retry_period, not schedule_interval ==='
=== BGW-FULL-RETRY-BACKOFF: retry uses retry_period, not schedule_interval ===
CREATE PROCEDURE noop_retry_fail(jid int, cfg jsonb) LANGUAGE plpgsql AS $$
BEGIN RAISE EXCEPTION 'retry-test deliberate failure'; END$$;
SELECT add_job('noop_retry_fail'::regproc,
               '1 hour'::interval) AS jid_retry \gset
-- retry_period is not in add_job's signature; set it via alter_job.
SELECT (alter_job(:jid_retry,
                  retry_period => '30 seconds'::interval)).id IS NOT NULL
       AS retry_period_set;
 retry_period_set 
------------------
 t
(1 row)

-- Force first tick to fire.
UPDATE time_series.bgw_job_stat
   SET next_start = '2024-01-04 11:00:00+00'::timestamptz
 WHERE job_id = :jid_retry;
SELECT time_series.bgw_params_reset_time(
    extract(epoch from '2024-01-04 12:00:00+00'::timestamptz)::bigint * 1000000,
    false);
 bgw_params_reset_time 
-----------------------
 
(1 row)

-- Run scheduler; job runs, fails, mark_end records failure.
SELECT time_series.bgw_db_scheduler_test_run_and_wait_for_scheduler_finish(60000);
 bgw_db_scheduler_test_run_and_wait_for_scheduler_finish 
---------------------------------------------------------
 
(1 row)

-- After 1st failure with consecutive_failures = 1, scheduler must
-- backoff by retry_period × 1 = 30 s.  Schedule_interval (1 h) is
-- 120× larger; if the scheduler regressed to that path the diff
-- would be in the hour range, not seconds-to-minutes.
SELECT total_failures >= 1                                  AS failure_recorded,
       consecutive_failures >= 1                            AS consecutive_advanced,
       last_run_success = false                             AS last_run_marked_failure,
       -- retry_period (30 s) × backoff(1..20) is at most 10 min.
       -- schedule_interval (1 h) would put next_start well beyond 10 min.
       (next_start - last_finish) <= '10 minutes'::interval AS retry_uses_retry_period,
       -- The 15 s lower bound asserts the EXECUTION-failure backoff
       -- (retry_period × N, 30 s × [0.875, 1.125] jitter => ≥ 26 s).
       -- A LAUNCH failure (momentary bgworker-slot pressure, e.g.
       -- another suite's schedulers still winding down) deliberately
       -- uses a different quick-retry contract of ~2-3 s -- that is
       -- correct behavior, not the regression this guards against,
       -- so it is treated as vacuously true instead of flaking.
       ((next_start - last_finish) >= '15 seconds'::interval
        OR EXISTS (SELECT 1 FROM time_series.bgw_job_stat_history
                    WHERE job_id = :jid_retry
                      AND data::text LIKE '%failed to start job%'))
       AS retry_not_too_fast
  FROM time_series.bgw_job_stat WHERE job_id = :jid_retry;
 failure_recorded | consecutive_advanced | last_run_marked_failure | retry_uses_retry_period | retry_not_too_fast 
------------------+----------------------+-------------------------+-------------------------+--------------------
 t                | t                    | t                       | t                       | t
(1 row)

-- Cleanup
SELECT delete_job(:jid_retry);
 delete_job 
------------
 
(1 row)

DROP PROCEDURE noop_retry_fail(int, jsonb);
-- ============================================================
-- BGW-FAILURE-RECOVERY: consecutive_failures resets to 0 after a
--   successful run
--
-- Contract (src/bgw/job_stat.c::bgw_job_stat_mark_end): when a job
-- run succeeds, mark_end sets consecutive_failures = 0 regardless
-- of prior value.  This is the "transient outage recovery" path —
-- without it, a job that failed N times then started succeeding
-- would still look "in failure mode" to operators and to
-- bgw_job_check_max_retries.
--
-- Test design: register a procedure that fails on first run, then
-- replace its body with a no-op via CREATE OR REPLACE (same OID, no
-- alter_job needed).  Drive two virtual-clock dispatches and verify
-- consecutive_failures went 0 → ≥1 → 0.
-- ============================================================
\echo '=== BGW-FAILURE-RECOVERY: consecutive_failures resets after success ==='
=== BGW-FAILURE-RECOVERY: consecutive_failures resets after success ===
CREATE PROCEDURE noop_recovery(jid int, cfg jsonb) LANGUAGE plpgsql AS $$
BEGIN RAISE EXCEPTION 'recovery-test deliberate failure'; END$$;
SELECT add_job('noop_recovery'::regproc, '1 hour'::interval) AS jid_recov \gset
-- Tick 1: failure — consecutive_failures must advance.
UPDATE time_series.bgw_job_stat
   SET next_start = '2024-01-07 10:00:00+00'::timestamptz
 WHERE job_id = :jid_recov;
SELECT time_series.bgw_params_reset_time(
    extract(epoch from '2024-01-07 11:00:00+00'::timestamptz)::bigint * 1000000,
    false);
 bgw_params_reset_time 
-----------------------
 
(1 row)

SET client_min_messages TO error;
SELECT time_series.bgw_db_scheduler_test_run_and_wait_for_scheduler_finish(60000);
 bgw_db_scheduler_test_run_and_wait_for_scheduler_finish 
---------------------------------------------------------
 
(1 row)

RESET client_min_messages;
SELECT total_failures >= 1     AS failure_recorded,
       consecutive_failures >= 1 AS consec_after_fail
  FROM time_series.bgw_job_stat WHERE job_id = :jid_recov;
 failure_recorded | consec_after_fail 
------------------+-------------------
 t                | t
(1 row)

-- Replace proc body with a no-op success (same OID, scheduler keeps
-- the same proc_name/proc_schema, no relcache invalidation needed).
CREATE OR REPLACE PROCEDURE noop_recovery(jid int, cfg jsonb)
LANGUAGE plpgsql AS $$ BEGIN END $$;
-- Tick 2: success — consecutive_failures must reset to 0.
UPDATE time_series.bgw_job_stat
   SET next_start = '2024-01-07 10:00:00+00'::timestamptz
 WHERE job_id = :jid_recov;
SELECT time_series.bgw_params_reset_time(
    extract(epoch from '2024-01-07 12:00:00+00'::timestamptz)::bigint * 1000000,
    false);
 bgw_params_reset_time 
-----------------------
 
(1 row)

SELECT time_series.bgw_db_scheduler_test_run_and_wait_for_scheduler_finish(60000);
 bgw_db_scheduler_test_run_and_wait_for_scheduler_finish 
---------------------------------------------------------
 
(1 row)

SELECT total_successes >= 1                AS success_recorded,
       consecutive_failures = 0            AS consec_reset_to_zero,
       last_run_success = true             AS last_run_now_succeeds
  FROM time_series.bgw_job_stat WHERE job_id = :jid_recov;
 success_recorded | consec_reset_to_zero | last_run_now_succeeds 
------------------+----------------------+-----------------------
 t                | t                    | t
(1 row)

SELECT delete_job(:jid_recov);
 delete_job 
