--  coverage for this file is intentionally deferred.  Source data
--  here is anchored to wall-clock now() so bucket-vs-chunk
--  alignment varies day-to-day and locking exact diff counts into
--  expected output would daily-flake.  Deterministic chunk-aware
--  coverage of the refresh path lives in cagg_bgw_policy_run.sql
--  RUN-CHUNK-01..04 instead, where fixed 2024-01-01 timestamps make
--  every assertion stable.  This file's contribution is the
--  multi-CAGG dispatch regression directly above.)
-- ============================================================
-- Cleanup
-- ============================================================
SELECT remove_continuous_aggregate_policy('cv_fail_mock');
