-- Grid alignment: (next_start - initial_start) MUST be exact multiple
-- of schedule_interval.  Modulus = 0 ⇔ grid; ≠ 0 ⇔ drift-mode bug.
SELECT
    (extract(epoch from (next_start - '2024-01-03 12:00:00+00'::timestamptz))::bigint
        % extract(epoch from '1 hour'::interval)::bigint) = 0
        AS next_start_on_grid
  FROM time_series.bgw_job_stat WHERE job_id = :jid_grid;
