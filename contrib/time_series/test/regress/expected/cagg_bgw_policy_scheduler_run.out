DROP PROCEDURE noop_recovery(int, jsonb);
-- ============================================================
-- BGW-FULL-MAX-RETRIES: consecutive_failures >= max_retries
--   auto-unschedules the job
--
-- Contract (V1 implements at src/bgw/job.c:715-742
-- bgw_job_check_max_retries): when max_retries is a non-negative
-- integer and consecutive_failures reaches it, the scheduler flips
-- bgw_job.scheduled to false and stops dispatching the job.  This
-- is the operator safety net for permanently-broken jobs —
-- without it, a permanently-failing refresh would dispatch a
-- worker every tick forever (pool exhaustion + log pollution).
--
-- Default max_retries = -1 means unlimited (upstream-compatible).
-- This test exercises the positive-N safety path.
-- ============================================================
\echo '=== BGW-FULL-MAX-RETRIES: max_retries reached -> auto-unschedule ==='
=== BGW-FULL-MAX-RETRIES: max_retries reached -> auto-unschedule ===
CREATE PROCEDURE noop_maxr_fail(jid int, cfg jsonb) LANGUAGE plpgsql AS $$
BEGIN RAISE EXCEPTION 'max-retries test failure'; END$$;
SELECT add_job('noop_maxr_fail'::regproc, '1 hour'::interval) AS jid_maxr \gset
SELECT (alter_job(:jid_maxr,
                  retry_period => '1 second'::interval,
                  max_retries  => 2)).id IS NOT NULL AS max_retries_capped_at_2;
 max_retries_capped_at_2 
-------------------------
 t
(1 row)

-- Drive 4 dispatch attempts with backdated next_start; max_retries=2
-- means after the 2nd consecutive failure the scheduler must
-- unschedule.  Any subsequent attempts must NOT fire workers.
-- Suppress the expected WARNING ("job N reached max_retries...")
-- so expected/.out stays deterministic.
SET client_min_messages TO error;
UPDATE time_series.bgw_job_stat
   SET next_start = '2024-01-06 10:00:00+00'::timestamptz
 WHERE job_id = :jid_maxr;
SELECT time_series.bgw_params_reset_time(
    extract(epoch from '2024-01-06 11:00:00+00'::timestamptz)::bigint * 1000000,
    false);
