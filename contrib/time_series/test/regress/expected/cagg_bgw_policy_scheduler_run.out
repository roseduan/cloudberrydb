-- ============================================================
-- BGW-FULL-MULTI-CAGG-DISPATCH: 3 CAGGs on same hypertable, all
--   eligible in one scheduler tick, must dispatch without crash.
--
-- Regression for the SIGSEGV path observed at:
--   #2 pfree() in errfinish() at cdbgang_async.c:256 — message buffer
--      chunk header clobbered (0x7f7f...)
--   #4 cdbgang_createGang_async at cdbgang_async.c:256
--   #5..#10 BeginInternalSubTransaction → AllocateGang during
--           calculate_next_start_on_failure → bgw_job_stat_mark_end
--           → bgw_job_entrypoint
--
-- Trigger condition (pre-fix): a refresh worker hit elog(LOG, "segment
-- is in reset/recovery mode") during gang dispatch.  emit_log_hook
-- (registered for ALL jobs by test_job_dispatcher, including real
-- CAGG refresh workers) attempted SPI_execute INSERT into bgw_log.
-- That SPI dispatch hit "query plan with multiple segworker groups
-- is not supported" because a gang dispatch was already in progress.
-- The inner ERROR got promoted to FATAL (PG_exception_stack unwound
-- during errfinish) which called MemoryContextReset(ErrorContext),
-- wiping the outer LOG's message buffer.  The outer errfinish then
-- crashed on pfree(edata->message) — chunk header read garbage.
--
-- Fix #1 (test/mock_time/scheduler_mock.c): test_job_dispatcher only
-- registers emit_log_hook for SYNTHETIC test jobs.  Real CAGG refresh
-- jobs (the default fall-through case) no longer get the hook, so
-- the SPI write that triggers the cascade can't fire.
--
-- Fix #2 (test/mock_time/log.c): emit_log_hook_callback early-returns
-- when IsAbortInProgress() or IsAbortedTransactionBlockState() — defense
-- in depth for the abort-path variant of the same cascade.
--
-- The test asserts that the scheduler tick completes without crashing
-- the worker: if any worker SIGSEGVs the whole regression run hangs
-- (the scheduler keeps waiting for a worker that's been postmaster-
-- reaped), and pg_regress times out.  A clean completion is the pass
-- signal — we don't need any further assertion.
-- ============================================================
\echo '=== BGW-FULL-MULTI-CAGG-DISPATCH: 3 CAGGs / 1 tick / no worker crash ==='
=== BGW-FULL-MULTI-CAGG-DISPATCH: 3 CAGGs / 1 tick / no worker crash ===
CREATE MATERIALIZED VIEW cv_full_mat_only
WITH (time_series.continuous, time_series.materialized_only=true) AS
  SELECT time_bucket('1 hour'::interval, time) AS bucket,
         tags_id, count(*) AS c, sum(v) AS s
  FROM m_full GROUP BY 1, 2;
NOTICE:  continuous aggregate "cv_full_mat_only" successfully created
DETAIL:  Materialization table: time_series._mat_cv_full_mat_only_3
SELECT add_continuous_aggregate_policy('cv_full_mat_only',
       '7 days'::interval, '0'::interval, '12 hours'::interval) AS jid_mat \gset
-- All three policies (cv_full, cv_fail_mock, cv_full_mat_only) get
-- eligible in the same tick because their next_starts (set by earlier
-- sections at mock times <= 2024-01-05) are all earlier than the
-- mock clock below.  The scheduler dispatches all 3 concurrently —
-- which is exactly the multi-gang configuration the SIGSEGV cascade
-- needed.
UPDATE time_series.bgw_job_stat
   SET next_start = '2023-12-31 23:00:00+00'::timestamptz
 WHERE job_id = :jid_mat;
SELECT time_series.bgw_params_reset_time(
    extract(epoch from '2024-01-08 12:00:00+00'::timestamptz)::bigint * 1000000,
    false);
 bgw_params_reset_time 
-----------------------
 
(1 row)

