SELECT
  time_series.time_bucket('1month', ts) AS "UTC",
  time_series.time_bucket('1month', ts, 'Europe/Berlin') AS "Berlin",
  time_series.time_bucket('1month', ts, 'America/New_York') AS "New_York",
