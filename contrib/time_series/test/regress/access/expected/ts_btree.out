  DISTRIBUTED BY (val);
CREATE INDEX ts_b_dup_idx ON ts_b_dup USING ts_btree (ts);
-- Insert rows with identical timestamps
INSERT INTO ts_b_dup VALUES
    ('2025-01-01 12:00:00+00', 1),
    ('2025-01-01 12:00:00+00', 2),
    ('2025-01-01 12:00:00+00', 3);
