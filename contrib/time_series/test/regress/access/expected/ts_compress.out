SELECT DISTINCT chunk_number, status, pax_file IS NULL AS no_pax
FROM time_series.ts_compressed_chunk_info('ts_comp_info_active'::regclass)
ORDER BY chunk_number;
 chunk_number | status | no_pax 
--------------+--------+--------
            4 |      0 | t
(1 row)

