-- ============================================================
-- Perm DROP-SOURCE-MID-REFRESH (P0): DROP TABLE source CASCADE
--   while another session is mid-refresh.  More dangerous than
--   DROP-MID-REFRESH on the CAGG above: refresh reads FROM the
--   source table while running its materialization SQL.  If the
--   source disappears mid-query, refresh worker can either:
--     (a) hit AccessShare lock conflict → DROP blocks
--     (b) read past the lock release → SIGSEGV / undefined data
--   The first is correct; the second is a P0 data-integrity bug.
-- ============================================================

1: CREATE TABLE drop_src2 (time TIMESTAMPTZ NOT NULL, device INT NOT NULL, val FLOAT8) USING time_series WITH ( ts_partition_column = 'time', ts_chunk_interval   = '4 hour', ts_chunk_origin     = '2020-01-01' ) DISTRIBUTED BY (device);
CREATE
1: INSERT INTO drop_src2 SELECT '2024-01-01'::timestamptz + (i * interval '6 min'), (i % 5) + 1, i FROM generate_series(1, 100) i;
INSERT 100

1: CREATE MATERIALIZED VIEW cv_drop_src_test WITH (time_series.continuous) AS SELECT time_bucket('1 hour'::interval, time) AS bucket, device, count(*) AS cnt FROM drop_src2 GROUP BY bucket, device;
