set extra_float_digits = -1;
ANALYZE;
explain (costs off) select
	cntrycode,
	count(*) as numcust,
	sum(c_acctbal) as totacctbal
from
	(
		select
			substring(c_phone from 1 for 2) as cntrycode,
			c_acctbal
		from
			customer
		where
			substring(c_phone from 1 for 2) in
				('13', '31', '23', '29', '30', '18', '17')
			and c_acctbal > (
				select
						avg(c_acctbal)
				from
						customer
				where
						c_acctbal > 0.00
						and substring(c_phone from 1 for 2) in
								('13', '31', '23', '29', '30', '18', '17')
			)
			and not exists (
				select
						*
				from
						orders
				where
						o_custkey = c_custkey
			)
	) as custsale
group by
	cntrycode
order by
	cntrycode;	
                                                                   QUERY PLAN                                                                    
-------------------------------------------------------------------------------------------------------------------------------------------------
 Vec Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: (SUBSTRING(customer.c_phone FROM 1 FOR 2))
   InitPlan 1 (returns $0)  (slice4)
     ->  Vec Finalize Vec Aggregate
           ->  Vec Gather Motion 3:1  (slice5; segments: 3)
                 ->  Vec Partial Vec Aggregate
                       ->  Vec Seq Scan on customer customer_1
                             Filter: ((c_acctbal > 0.00) AND (SUBSTRING(c_phone FROM 1 FOR 2) = ANY ('{13,31,23,29,30,18,17}'::text[])))
   ->  Vec GroupAggregate
         Group Key: (SUBSTRING(customer.c_phone FROM 1 FOR 2))
         ->  Vec Sort
               Sort Key: (SUBSTRING(customer.c_phone FROM 1 FOR 2))
               ->  Vec Redistribute Motion 3:3  (slice2; segments: 3)
                     Hash Key: (SUBSTRING(customer.c_phone FROM 1 FOR 2))
                     ->  Vec Hash Right Anti Join
                           Hash Cond: (orders.o_custkey = customer.c_custkey)
                           ->  Vec Redistribute Motion 3:3  (slice3; segments: 3)
                                 Hash Key: orders.o_custkey
                                 ->  Vec Seq Scan on orders
                           ->  Vec Hash
                                 ->  Vec Seq Scan on customer
                                       Filter: ((c_acctbal > $0) AND (SUBSTRING(c_phone FROM 1 FOR 2) = ANY ('{13,31,23,29,30,18,17}'::text[])))
 Optimizer: Postgres query optimizer
(23 rows)

select
	cntrycode,
	count(*) as numcust,
	sum(c_acctbal) as totacctbal
from
	(
		select
			substring(c_phone from 1 for 2) as cntrycode,
			c_acctbal
		from
			customer
		where
			substring(c_phone from 1 for 2) in
				('13', '31', '23', '29', '30', '18', '17')
			and c_acctbal > (
				select
						avg(c_acctbal)
				from
						customer
				where
						c_acctbal > 0.00
						and substring(c_phone from 1 for 2) in
								('13', '31', '23', '29', '30', '18', '17')
			)
			and not exists (
				select
						*
				from
						orders
				where
						o_custkey = c_custkey
			)
	) as custsale
group by
	cntrycode
order by
	cntrycode;	
