create or replace function print_text_arrays(
    in array1 text[],
    in array2 text[]
)
returns text[]
language plpgsql volatile
as $$
begin
	return array1 || array2;
end;
$$;
create table outer_sublink as
select 'a' as col1, array[null] as col2
union all
select 'b' as col1, array[null] as col2
union all
select 'c' as col1, array['abc','def'] as col2
;
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause. Creating a NULL policy entry.
explain select * from outer_sublink where exists (select unnest(print_text_arrays(col2,col2)) order by 1) order by 1;
                                             QUERY PLAN                                              
-----------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)  (cost=512.55..759.05 rows=17400 width=64)
   Merge Key: outer_sublink.col1
   ->  Sort  (cost=512.55..527.05 rows=5800 width=64)
         Sort Key: outer_sublink.col1
         ->  Seq Scan on outer_sublink  (cost=0.00..150.00 rows=5800 width=64)
               Filter: (SubPlan 1)
               SubPlan 1
                 ->  Sort  (cost=0.48..0.51 rows=10 width=32)
                       Sort Key: (unnest(print_text_arrays(outer_sublink.col2, outer_sublink.col2)))
                       ->  ProjectSet  (cost=0.00..0.32 rows=10 width=32)
                             ->  Result  (cost=0.00..0.01 rows=1 width=0)
 Optimizer: Postgres query optimizer
(12 rows)

