 Settings: optimizer = 'off'
 Optimizer: Postgres query optimizer
(11 rows)

-- ------------------------------------------------------------------
-- C) Correctness: sonic-routed aggregates must match the reference.
-- ------------------------------------------------------------------
-- Reference: straightforward grouped aggregate, ordered for stable diff.
SELECT i32,
       count(*)             AS c,
       sum(i64)             AS s_i,
       sum(n)               AS s_n,
       avg(i64)::numeric(20,4) AS a_i,
       min(t)               AS mn_t
FROM sn
GROUP BY i32
ORDER BY i32;
 i32 |  c  | s_i  |   s_n    |   a_i   | mn_t 
-----+-----+------+----------+---------+------
   0 | 100 | 5050 |  5050.00 | 50.5000 | A
   1 | 100 | 5950 | 14950.00 | 59.5000 | B
   2 | 100 | 6950 | 24950.00 | 69.5000 | C
   3 | 100 | 7950 | 34950.00 | 79.5000 | D
   4 | 100 | 8950 | 44950.00 | 89.5000 | E
(5 rows)

-- GROUP BY text correctness.
SELECT t, count(*) AS c
FROM sn
GROUP BY t
ORDER BY t;
 t |  c  
---+-----
 A | 100
 B | 100
 C | 100
 D | 100
 E | 100
(5 rows)

-- GROUP BY date correctness.
SELECT d, count(*) AS c, sum(i64) AS s
FROM sn
GROUP BY d
ORDER BY d;
     d      |  c  |  s   
------------+-----+------
 01-01-2026 | 100 | 5050
 01-02-2026 | 100 | 5950
 01-03-2026 | 100 | 6950
 01-04-2026 | 100 | 7950
 01-05-2026 | 100 | 8950
(5 rows)

-- ------------------------------------------------------------------
-- D) Sonic + Limit+HashAgg fusion are mutually exclusive: when fusion
--    fires the method is Limit+HashAgg, not Sonic (sonic does not yet
--    honor AggregateNodeOptions::limit_count).
-- ------------------------------------------------------------------
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT i32, count(*) FROM sn GROUP BY i32 LIMIT 3;
                            QUERY PLAN                            
------------------------------------------------------------------
 Vec Limit
   Output: i32, (count(*))
   ->  Vec Gather Motion 3:1  (slice1; segments: 3)
         Output: i32, (count(*))
         ->  Vec Limit
               Output: i32, (count(*))
               Vec Plan Merge:  1 child
               ->  Vec HashAggregate
                     Output: i32, count(*)
                     Group Key: sn.i32
                     Vec HashAgg Method:  Limit+HashAgg  Limit: 3
                     Vec Plan Merge:  1 child
                     ->  Vec Seq Scan on vec_sonic.sn
                           Output: i32
 Settings: optimizer = 'off'
 Optimizer: Postgres query optimizer
(16 rows)

-- ------------------------------------------------------------------
-- Cleanup.
-- ------------------------------------------------------------------
SET search_path = public;
DROP SCHEMA vec_sonic CASCADE;
NOTICE:  drop cascades to table vec_sonic.sn
RESET optimizer;
RESET default_table_access_method;
RESET vector.enable_vectorization;
