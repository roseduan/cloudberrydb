               ->  Seq Scan on s1  (cost=0.00..431.00 rows=1 width=16)
                     Filter: ((a < 0) OR (a > 0))
   ->  Nested Loop  (cost=0.00..1324032.33 rows=1 width=32)
         Join Filter: true
         ->  Result  (cost=0.00..431.00 rows=1 width=16)
               Filter: (share0_ref3.a < 0)
               ->  Shared Scan (share slice:id 0:0)  (cost=0.00..431.00 rows=1 width=16)
         ->  Materialize  (cost=0.00..431.00 rows=1 width=16)
               ->  Result  (cost=0.00..431.00 rows=1 width=16)
                     Filter: (share0_ref2.a > 0)
                     ->  Shared Scan (share slice:id 0:0)  (cost=0.00..431.00 rows=1 width=16)
 Optimizer: GPORCA
