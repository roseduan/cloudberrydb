-- parallel index only scan (broadcast motion, join with small table)
explain (verbose, costs off) select pios1.a, pios1.b from pios1 join pios3 on pios1.a = pios3.h where pios1.a < 5000;
                                                                         QUERY PLAN                                                                         
------------------------------------------------------------------------------------------------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   Output: pios1.a, pios1.b
   ->  Parallel Hash Join
         Output: pios1.a, pios1.b
         Hash Cond: (pios1.a = pios3.h)
         ->  Parallel Index Only Scan using pios1_ab_idx on orca_index_parallel.pios1
               Output: pios1.a, pios1.b
               Index Cond: (pios1.a < 5000)
         ->  Parallel Hash
               Output: pios3.h
               ->  Redistribute Motion 6:6  (slice2; segments: 6)
                     Output: pios3.h
                     Hash Key: pios3.h
                     Hash Module: 3
                     ->  Parallel Index Only Scan using pios3_h_idx on orca_index_parallel.pios3
                           Output: pios3.h
