-- Nested subquery with LIMIT - inner limit should prevent parallel bitmap scan
explain (costs off)
select * from pbms1 where a in (
    select d from pbms2 where d in (
        select a from pbms1 limit 5
    )
) and (b = 10 or b = 20);
                                          QUERY PLAN                                          
----------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Hash Semi Join
         Hash Cond: (pbms1.a = pbms2.d)
         ->  Bitmap Heap Scan on pbms1
               Recheck Cond: ((b = 10) OR (b = 20))
               ->  BitmapOr
                     ->  Bitmap Index Scan on pbms1_b_idx
                           Index Cond: (b = 10)
                     ->  Bitmap Index Scan on pbms1_b_idx
                           Index Cond: (b = 20)
         ->  Hash
               ->  Hash Semi Join
                     Hash Cond: (pbms2.d = pbms1_1.a)
                     ->  Bitmap Heap Scan on pbms2
                           ->  Bitmap Index Scan on pbms2_d_idx
                     ->  Hash
                           ->  Redistribute Motion 1:3  (slice2; segments: 1)
                                 Hash Key: pbms1_1.a
                                 ->  Limit
                                       ->  Gather Motion 3:1  (slice3; segments: 3)
                                             ->  Limit
                                                   ->  Bitmap Heap Scan on pbms1 pbms1_1
                                                         ->  Bitmap Index Scan on pbms1_a_idx
