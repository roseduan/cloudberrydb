reset optimizer_enable_bitmapscan;
reset optimizer_enable_tablescan;
reset optimizer_enable_indexscan;
reset enable_bitmapscan;
reset enable_seqscan;
reset enable_indexscan;
-- semi join with parallel bitmap heap scan
-- Drop pbms2_d_idx so ORCA prefers Hash Semi Join over correlated NL + Index probe
drop index pbms2_d_idx;
explain (verbose, costs off) select * from pbms1 where exists (select 1 from pbms2 where pbms2.d = pbms1.a) and (b = 10 or b = 20);
                                      QUERY PLAN                                      
--------------------------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   Output: pbms1.a, pbms1.b, pbms1.c
   ->  HashAggregate
         Output: pbms1.a, pbms1.b, pbms1.c
         Group Key: (RowIdExpr)
         ->  Redistribute Motion 6:6  (slice2; segments: 6)
               Output: pbms1.a, pbms1.b, pbms1.c, (RowIdExpr)
               Hash Key: (RowIdExpr)
               Hash Module: 3
               ->  Parallel Hash Join
                     Output: pbms1.a, pbms1.b, pbms1.c, (RowIdExpr)
                     Hash Cond: (pbms2.d = pbms1.a)
                     ->  Parallel Seq Scan on orca_index_parallel.pbms2
                           Output: pbms2.d, pbms2.e, pbms2.f
                     ->  Parallel Hash
                           Output: pbms1.a, pbms1.b, pbms1.c, (RowIdExpr)
                           ->  Parallel Bitmap Heap Scan on orca_index_parallel.pbms1
                                 Output: pbms1.a, pbms1.b, pbms1.c, RowIdExpr
                                 Recheck Cond: ((pbms1.b = 10) OR (pbms1.b = 20))
                                 ->  BitmapOr
                                       ->  Bitmap Index Scan on pbms1_b_idx
                                             Index Cond: (pbms1.b = 10)
                                       ->  Bitmap Index Scan on pbms1_b_idx
                                             Index Cond: (pbms1.b = 20)
 Settings: enable_parallel = 'on', optimizer = 'off', parallel_setup_cost = '0'
 Optimizer: Postgres query optimizer
