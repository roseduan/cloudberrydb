# Copy to datalake_rest_catalog.env (gitignored) and fill in.
# Sourced by bin/datalake_rest_catalog_ctl.sh at start. Provides the S3
# credentials the gateway uses to read metadata.json (server-side FileIO).
# Non-secret config (endpoint, pg url, port) comes from the jar's bundled
# gateway.properties.
export S3_ACCESS_KEY_ID=minioadmin
export S3_SECRET_ACCESS_KEY=minioadmin

# Optional overrides:
# export DRC_JAVA_HOME=/opt/jdk17      # any JDK >= 11 (jar targets release 11)
# export DRC_JAR=/abs/path/to/datalake-rest-catalog-1.0.0.jar
# export SERVER_PORT=8181
