# Copy to datalake_rest_catalog.env (gitignored) and fill in. Optional: sourced by
# bin/datalake_rest_catalog_ctl.sh at start if present.
#
# The gateway needs NO object storage credentials. metadata.json is read through the
# database (pg_ext_aux.iceberg_load_metadata) and data files are read by the client with
# its own credentials, so there is deliberately no S3_ACCESS_KEY_ID here any more.
#
# Non-secret config (pg url, ports, TLS) comes from the jar's bundled gateway.properties;
# every key there has an env override (pg.jdbcUrl -> PG_JDBCURL, and so on).

# Secrets, if you do not want them in gateway.properties:
# export PG_PASSWORD=...
# export JWT_SECRET=...              # base64, >= 32 bytes

# Optional overrides:
# export DRC_JAVA_HOME=/opt/jdk17    # any JDK >= 11 (jar targets release 11)
# export DRC_JAR=/abs/path/to/datalake-rest-catalog-1.0.0.jar
# export SERVER_PORT=8181
