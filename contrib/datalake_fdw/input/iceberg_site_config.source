-- Site-config parser: what the coordinator makes of s3.conf / gphdfs.conf.
--
-- test/sitediff holds this parser to the datalake agent, but needs maven and
-- an agent build.  This needs neither, so it is what a normal regression run
-- relies on to notice the parser's behaviour changed.  Same fixtures, so the
-- two cannot drift apart.
--
-- Each case asserts the fields it is about rather than the whole dump: a new
-- field in the renderer should not turn every case red, and the field named in
-- a query says what the case is testing.

-- Quiet, so the result does not depend on whether an earlier test in the
-- schedule already created the extension.
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS datalake_fdw;
RESET client_min_messages;

\set s3 '@abs_srcdir@/test/sitediff/fixtures/s3'
\set hdfs '@abs_srcdir@/test/sitediff/fixtures/hdfs'
\set empty '@abs_srcdir@/test/sitediff/fixtures/empty'
\set nofile '@abs_srcdir@/test/sitediff/fixtures/nofile'

-- A plain section.
SELECT j->>'volumeEndpoint' AS endpoint, j->>'volumeRegion' AS region,
       j->>'bucketName' AS bucket, j->>'pathStyleAccess' AS path_style,
       j->>'accessKeyId' AS akid, j->>'username' AS username
FROM (SELECT pg_iceberg_site_config('minio', 's3', :'s3')::json) AS t(j);

-- Two steps decide a boolean, and they disagree about case.  YAML 1.1's
-- resolver only recognises fixed spellings (yes/Yes/YES, true/True/TRUE), so
-- bare yes is a boolean while yEs and tRue stay strings.  Whatever survives as
-- a string then meets Boolean.parseBoolean, which matches "true"
-- case-insensitively.  Hence tRue is true, yEs is false, and 1 -- resolved as
-- an integer, rendered "1" -- is false as well.  Quoting "yes" keeps it a
-- string that parseBoolean rejects, so quoting flips the value.
SELECT s AS section, (pg_iceberg_site_config(s, 's3', :'s3')::json)->>'pathStyleAccess' AS path_style
FROM unnest(ARRAY['bool_yes','bool_quoted','bool_tRue','bool_yEs','bool_one','bool_absent']) AS s;

-- Retyped scalars.  01234567 is octal to YAML 1.1, which rewrites a
-- credential; 1_000 carries a digit separator; 0x1F is hex; a key with no
-- value is null, not an empty string.  Getting any of these wrong hands the
-- storage layer a secret nobody configured.
SELECT j->>'volumeEndpoint' AS endpoint, j->>'volumeRegion' AS region,
       j->>'bucketName' AS bucket, j->>'accessKeyId' AS akid,
       j->>'secretAccessKey' AS secret, j->>'username' AS username
FROM (SELECT pg_iceberg_site_config('typing', 's3', :'s3')::json) AS t(j);

-- A value YAML reads as a float, a timestamp or a sexagesimal is refused
-- rather than guessed at: the agent would render it by Java rules this parser
-- cannot reproduce, and a silently different endpoint is the failure mode the
-- whole equivalence exercise exists to avoid.  One statement each, since the
-- first error would otherwise hide the rest.
SELECT pg_iceberg_site_config('floaty', 's3', :'s3');
SELECT pg_iceberg_site_config('stamp', 's3', :'s3');
SELECT pg_iceberg_site_config('sexa', 's3', :'s3');

-- Unknown keys travel through opaquely; a valueless one is dropped.
SELECT j->>'volumeEndpoint' AS endpoint, j->'extraProperties' AS extras
FROM (SELECT pg_iceberg_site_config('extras', 's3', :'s3')::json) AS t(j);

-- Duplicates follow the agent's Map semantics -- last wins.  The older reader
-- in provider/common/config.c takes the first, which is why this is pinned.
SELECT s AS section, (pg_iceberg_site_config(s, 's3', :'s3')::json)->>'volumeEndpoint' AS endpoint
FROM unnest(ARRAY['dupkey','dupsec']) AS s;

-- HDFS typed fields.
SELECT j->>'hdfsNamenodeHost' AS namenode, j->>'hdfsNamenodePort' AS port,
       j->>'username' AS username, j->>'hdfsAuthMethod' AS auth
FROM (SELECT pg_iceberg_site_config('nn', 'hdfs', :'hdfs')::json) AS t(j);

-- HA keys are carried verbatim, not rewritten into hadoop spellings.
SELECT j->>'isHaSupported' AS ha, j->>'dfsNameservices' AS nameservices,
       j->>'dfsHaNamenodes' AS namenodes, j->>'dfsNamenodeRpcAddress' AS rpc_addr,
       j->>'dfsClientUseDatanodeHostname' AS use_hostname
FROM (SELECT pg_iceberg_site_config('ha', 'hdfs', :'hdfs')::json) AS t(j);

SELECT j->>'hdfsAuthMethod' AS auth, j->>'krbPrincipal' AS principal,
       j->>'hadoopRpcProtection' AS rpc_protection, j->'extraProperties' AS extras
FROM (SELECT pg_iceberg_site_config('kerberos', 'hdfs', :'hdfs')::json) AS t(j);

SELECT j->>'dataTransferProtocol' AS dtp, j->>'dataTransferProtection' AS protection,
       j->'extraProperties' AS extras
FROM (SELECT pg_iceberg_site_config('dtp', 'hdfs', :'hdfs')::json) AS t(j);

-- An empty file is not an error: the agent's YAML load returns null, warns,
-- and carries on, so refusing it would reject a deployment the agent accepts.
SELECT pg_iceberg_site_config('anything', 's3', :'empty') IS NOT NULL AS parsed_without_error;

-- An empty server_name means the agent never opens a file, so neither do we.
SELECT pg_iceberg_site_config('', 's3', :'s3') IS NOT NULL AS parsed_without_error;

-- Section lookup is case-sensitive, because the agent does Map.get().
SELECT pg_iceberg_site_config('MinIO', 's3', :'s3');

-- Missing file, missing section, non-scalar value, and a key YAML retypes to
-- a boolean -- all errors.
SELECT pg_iceberg_site_config('minio', 's3', :'nofile');
SELECT pg_iceberg_site_config('nosuchsection', 's3', :'s3');
SELECT pg_iceberg_site_config('nested', 's3', :'s3');
SELECT pg_iceberg_site_config('badkey', 's3', :'s3');

-- Legacy spellings are refused rather than ignored, so a conf file the agent
-- rejects cannot appear to work here.
SELECT pg_iceberg_site_config('legacy1', 's3', :'s3');
SELECT pg_iceberg_site_config('legacy_many', 's3', :'s3');
SELECT pg_iceberg_site_config('legacy_dotted', 'hdfs', :'hdfs');

-- Superuser only: base_dir is otherwise an arbitrary-file reader.
CREATE ROLE site_config_unpriv LOGIN;
SET SESSION AUTHORIZATION site_config_unpriv;
SELECT pg_iceberg_site_config('minio', 's3', :'s3');
RESET SESSION AUTHORIZATION;
DROP ROLE site_config_unpriv;
