-- Task 2 (#382/#935): kernel-side metadata.json reader.
-- Reads the real document via dlagent using the builtin volume's own credentials,
-- so the REST catalog gateway does not need object storage credentials of its own.
-- start_ignore
-- Whether this emits "already exists, skipping" depends on whether an earlier test in
-- the schedule created the extension, so the preamble is ignored (same convention as
-- iceberg_am_misuse.sql). Without this the test passes standalone and fails in-suite.
CREATE EXTENSION IF NOT EXISTS datalake_fdw;
-- end_ignore
-- Builtin catalog + S3 (MinIO) volume, scoped to this test.
CREATE SERVER mdr_catalog_srv FOREIGN DATA WRAPPER iceberg_catalog_fdw;
CREATE FOREIGN CATALOG mdr_catalog SERVER mdr_catalog_srv;
CREATE SERVER mdr_volume_srv FOREIGN DATA WRAPPER iceberg_volume_fdw
    OPTIONS (type 's3', endpoint 'http://localhost:9000', region 'us-east-1',
             bucket_name 'warehouse', path_style_access 'true');
CREATE USER MAPPING FOR CURRENT_USER SERVER mdr_volume_srv
    OPTIONS (access_key_id 'admin', secret_access_key 'admin12345');
CREATE FOREIGN VOLUME mdr_volume SERVER mdr_volume_srv OPTIONS (base_path '/mdr_test/');
SET iceberg_default_catalog = 'mdr_catalog';
SET iceberg_default_volume  = 'mdr_volume';
CREATE SCHEMA mdr;
CREATE ICEBERG TABLE mdr.t (id int, v text);
INSERT INTO mdr.t VALUES (1, 'a'), (2, 'b');
-- The document must come back non-empty, be valid JSON, and its location must match
-- what the catalog recorded (pg_ext_aux.pg_iceberg_metadata) -- not merely look like a
-- metadata path. This is the property that matters: the location cannot be forged or
-- substituted, only ever the one the builtin catalog registered for this relid.
-- Asserting on parsed fields rather than the raw text keeps the expected file stable
-- across metadata filename churn.
SELECT (metadata_json IS NOT NULL) AS got_doc,
       (metadata_json::jsonb ? 'format-version') AS has_format_version,
       (metadata_json::jsonb ? 'table-uuid') AS has_table_uuid,
       (metadata_location = (SELECT metadata_location FROM pg_ext_aux.pg_iceberg_metadata
                             WHERE relid = 'mdr.t'::regclass)) AS loc_matches_catalog
FROM pg_catalog.pg_iceberg_load_metadata_json_local('mdr.t'::regclass);
 got_doc | has_format_version | has_table_uuid | loc_matches_catalog 
---------+--------------------+----------------+---------------------
 t       | t                  | t              | t
(1 row)

-- The reader must reject a relation that is not a builtin iceberg table.
CREATE TABLE mdr.heap (id int);
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column named 'id' as the Apache Cloudberry data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
SELECT * FROM pg_catalog.pg_iceberg_load_metadata_json_local('mdr.heap'::regclass);
ERROR:  relation "heap" is not a builtin iceberg table
DROP SCHEMA mdr CASCADE;
NOTICE:  drop cascades to 2 other objects
DETAIL:  drop cascades to table mdr.t
drop cascades to table mdr.heap
DROP VOLUME mdr_volume;
DROP USER MAPPING FOR CURRENT_USER SERVER mdr_volume_srv;
DROP SERVER mdr_volume_srv;
DROP CATALOG mdr_catalog;
DROP SERVER mdr_catalog_srv;
