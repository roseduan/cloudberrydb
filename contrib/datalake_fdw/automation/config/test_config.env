# test_config.env
# Centralized configuration for datalake_fdw automation tests
# Source this file in bash scripts: source "$(dirname "$0")/../config/test_config.env"

# ============================================================================
# Database Connection Settings
# ============================================================================
export PGHOST=${PGHOST:-localhost}
export PGPORT=${PGPORT:-5432}
export PGDATABASE=${PGDATABASE:-postgres}
export PGUSER=${PGUSER:-gpadmin}

# ============================================================================
# Service Endpoints (Docker service names from docker-compose.yml)
# ============================================================================

# Hive Metastore
export HIVE_HOST=${HIVE_HOST:-hive-metastore}
export HIVE_SERVER_HOST=${HIVE_SERVER_HOST:-hiveserver2}
export HIVE_PORT=${HIVE_PORT:-10000}
export HIVE_METASTORE_PORT=${HIVE_METASTORE_PORT:-9083}

# MinIO (S3-compatible storage)
export MINIO_HOST=${MINIO_HOST:-minio}
export MINIO_PORT=${MINIO_PORT:-9000}
export MINIO_CONSOLE_PORT=${MINIO_CONSOLE_PORT:-9001}

# HDFS
export HDFS_NAMENODE=${HDFS_NAMENODE:-hadoop}
export HDFS_PORT=${HDFS_PORT:-8020}
export HDFS_WEBHDFS_PORT=${HDFS_WEBHDFS_PORT:-9870}

# Spark
export SPARK_MASTER_HOST=${SPARK_MASTER_HOST:-spark-master}
export SPARK_MASTER_PORT=${SPARK_MASTER_PORT:-7077}
export SPARK_MASTER_WEB_PORT=${SPARK_MASTER_WEB_PORT:-8080}

# Polaris (Iceberg catalog)
export POLARIS_HOST=${POLARIS_HOST:-polaris}
export POLARIS_PORT=${POLARIS_PORT:-8181}

# ============================================================================
# Credentials
# ============================================================================

# MinIO credentials
export MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY:-admin}
export MINIO_SECRET_KEY=${MINIO_SECRET_KEY:-admin12345}

# Hive credentials
export HIVE_USER=${HIVE_USER:-gpadmin}
export HIVE_PASSWORD=${HIVE_PASSWORD:-}

# Database credentials
export DB_USER=${DB_USER:-gpadmin}
export DB_PASSWORD=${DB_PASSWORD:-}

# ============================================================================
# Test Settings
# ============================================================================

# ============================================================================
# Run Profile: ci (default) / nightly / weekly
# Controls iteration counts, data sizes, and which test suites are enabled.
# ============================================================================
export RUN_PROFILE=${RUN_PROFILE:-ci}

if [ "$RUN_PROFILE" = "weekly" ]; then
    export PERF_ITERATIONS=${PERF_ITERATIONS:-10}
    export PERF_WARMUP_RUNS=${PERF_WARMUP_RUNS:-2}
    export PERF_DATA_SIZE=${PERF_DATA_SIZE:-100000}
    export STABILITY_SOAK_ITERATIONS=${STABILITY_SOAK_ITERATIONS:-500}
    export STABILITY_REPEAT_ITERATIONS=${STABILITY_REPEAT_ITERATIONS:-100}
    export SCALE_VOLUME_ROWS=${SCALE_VOLUME_ROWS:-100000000}
    export SCALE_MANY_FILES=${SCALE_MANY_FILES:-1000}
    export SCALE_CONCURRENCY=${SCALE_CONCURRENCY:-100}
    export ENABLE_CHAOS=${ENABLE_CHAOS:-true}
    export ENABLE_COMPAT=${ENABLE_COMPAT:-true}
elif [ "$RUN_PROFILE" = "nightly" ]; then
    export PERF_ITERATIONS=${PERF_ITERATIONS:-10}
    export PERF_WARMUP_RUNS=${PERF_WARMUP_RUNS:-2}
    export PERF_DATA_SIZE=${PERF_DATA_SIZE:-100000}
    export STABILITY_SOAK_ITERATIONS=${STABILITY_SOAK_ITERATIONS:-200}
    export STABILITY_REPEAT_ITERATIONS=${STABILITY_REPEAT_ITERATIONS:-50}
    export SCALE_VOLUME_ROWS=${SCALE_VOLUME_ROWS:-1000000}
    export SCALE_MANY_FILES=${SCALE_MANY_FILES:-100}
    export SCALE_CONCURRENCY=${SCALE_CONCURRENCY:-50}
    export ENABLE_CHAOS=${ENABLE_CHAOS:-false}
    export ENABLE_COMPAT=${ENABLE_COMPAT:-false}
else  # ci (default)
    export PERF_ITERATIONS=${PERF_ITERATIONS:-3}
    export PERF_WARMUP_RUNS=${PERF_WARMUP_RUNS:-1}
    export PERF_DATA_SIZE=${PERF_DATA_SIZE:-10000}
    export STABILITY_SOAK_ITERATIONS=${STABILITY_SOAK_ITERATIONS:-50}
    export STABILITY_REPEAT_ITERATIONS=${STABILITY_REPEAT_ITERATIONS:-10}
    export SCALE_VOLUME_ROWS=${SCALE_VOLUME_ROWS:-100000}
    export SCALE_MANY_FILES=${SCALE_MANY_FILES:-100}
    export SCALE_CONCURRENCY=${SCALE_CONCURRENCY:-10}
    export ENABLE_CHAOS=${ENABLE_CHAOS:-false}
    export ENABLE_COMPAT=${ENABLE_COMPAT:-false}
fi

# Test execution
export TEST_TIMEOUT=${TEST_TIMEOUT:-300}  # seconds
export TEST_PARALLEL=${TEST_PARALLEL:-1}  # Number of parallel tests

# Test data settings
export TEST_DATA_DIR=${TEST_DATA_DIR:-/tmp/datalake_test_data}
export TEST_WAREHOUSE_DIR=${TEST_WAREHOUSE_DIR:-/warehouse}

# ============================================================================
# Paths
# ============================================================================

# Automation directory (relative to test execution)
export AUTOMATION_DIR=${AUTOMATION_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
export LIB_DIR="${AUTOMATION_DIR}/lib"
export SCRIPTS_DIR="${AUTOMATION_DIR}/scripts"
export CONFIG_DIR="${AUTOMATION_DIR}/config"
export REPORTS_DIR="${AUTOMATION_DIR}/reports"
export SQLREPO_DIR="${AUTOMATION_DIR}/sqlrepo"

# CLI tools — installed by scripts/setup/install_tools.sh
export TOOLS_DIR="${AUTOMATION_DIR}/tools"
export TOOLS_BIN="${TOOLS_DIR}/bin"
export DOWNLOAD_CACHE_DIR="${AUTOMATION_DIR}/docker/singlecluster/download_cache"

# Tool versions — should match docker/singlecluster/Dockerfile
export HADOOP_VERSION=${HADOOP_VERSION:-3.0.0}
export HIVE_VERSION=${HIVE_VERSION:-3.0.0}
export SPARK_VERSION=${SPARK_VERSION:-3.3.3}
export HUDI_VERSION=${HUDI_VERSION:-0.13.1}

# ============================================================================
# Reporting Settings
# ============================================================================

# Report output
export REPORT_FORMAT=${REPORT_FORMAT:-text}  # text, json, html
export REPORT_TIMESTAMP=$(date +%Y%m%d_%H%M%S)
export REPORT_DIR="${REPORTS_DIR}/${REPORT_TIMESTAMP}"

# ============================================================================
# Logging Settings
# ============================================================================

export LOG_LEVEL=${LOG_LEVEL:-INFO}  # DEBUG, INFO, WARN, ERROR
export LOG_DIR="${REPORTS_DIR}/logs"
export LOG_FILE="${LOG_DIR}/test_${REPORT_TIMESTAMP}.log"

# ============================================================================
# Feature Flags
# ============================================================================

export ENABLE_SMOKE_TESTS=${ENABLE_SMOKE_TESTS:-true}
export ENABLE_PERFORMANCE_TESTS=${ENABLE_PERFORMANCE_TESTS:-true}
export ENABLE_FEATURE_TESTS=${ENABLE_FEATURE_TESTS:-true}

# ============================================================================
# Baseline Configuration
# ============================================================================

export BASELINE_FILE="${CONFIG_DIR}/baseline.json"
export BASELINE_TOLERANCE=${BASELINE_TOLERANCE:-10}  # percentage

# ============================================================================
# Helper Functions
# ============================================================================

# Function to check if a variable is set
check_required_vars() {
    local missing_vars=()
    for var in "$@"; do
        if [ -z "${!var}" ]; then
            missing_vars+=("$var")
        fi
    done

    if [ ${#missing_vars[@]} -gt 0 ]; then
        echo "Error: Required environment variables are not set:"
        printf '  %s\n' "${missing_vars[@]}"
        return 1
    fi
    return 0
}

# Function to create required directories
create_test_dirs() {
    mkdir -p "${REPORTS_DIR}"
    mkdir -p "${LOG_DIR}"
    mkdir -p "${REPORT_DIR}"
    mkdir -p "${TEST_DATA_DIR}"
}

# Initialize directories on source
create_test_dirs

# Export all functions
export -f check_required_vars
export -f create_test_dirs
