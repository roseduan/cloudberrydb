-- S3 Smoke Test: Hive writes -> Cloudberry reads (all formats)
-- Tests reading Hive-written data from MinIO via datalake_fdw
-- Prerequisite: beeline prepare script creates test data in MinIO
CREATE EXTENSION IF NOT EXISTS datalake_fdw;
CREATE FOREIGN DATA WRAPPER datalake_fdw
    HANDLER datalake_fdw_handler
    VALIDATOR datalake_fdw_validator
    OPTIONS (mpp_execute 'all segments');
-- Create S3 server (MinIO)
DROP SERVER IF EXISTS s3_server CASCADE;
NOTICE:  server "s3_server" does not exist, skipping
CREATE SERVER s3_server
    FOREIGN DATA WRAPPER datalake_fdw
    OPTIONS (host 'minio:9000', protocol 's3', isvirtual 'false', ishttps 'false');
CREATE USER MAPPING FOR gpadmin
    SERVER s3_server
    OPTIONS (user 'gpadmin', accesskey 'admin', secretkey 'admin12345');
-- ============================================================
-- Test 1: Hive Parquet -> CB read
-- ============================================================
DROP FOREIGN TABLE IF EXISTS s3_hive_parquet;
NOTICE:  foreign table "s3_hive_parquet" does not exist, skipping
CREATE FOREIGN TABLE s3_hive_parquet (id int, name text, amount decimal(10,2))
SERVER s3_server
OPTIONS (filePath '/warehouse/s3-smoke-hive-parquet/', format 'parquet');
SELECT * FROM s3_hive_parquet ORDER BY id;
 id |  name   | amount 
----+---------+--------
  1 | Alice   | 100.50
  2 | Bob     | 200.75
  3 | Charlie | 300.00
(3 rows)

SELECT COUNT(*) FROM s3_hive_parquet;
 count 
-------
     3
(1 row)

-- ============================================================
-- Test 2: Hive Avro -> CB read
