-- ============================================================
-- Test 4: Hive Text (comma-delimited) -> CB read
-- ============================================================
DROP FOREIGN TABLE IF EXISTS s3_hive_text;
NOTICE:  foreign table "s3_hive_text" does not exist, skipping
CREATE FOREIGN TABLE s3_hive_text (id int, name text, amount decimal(10,2))
SERVER s3_server
OPTIONS (filePath '/warehouse/s3-smoke-hive-text/', format 'csv', delimiter ',');
SELECT * FROM s3_hive_text ORDER BY id;
 id |  name   | amount 
----+---------+--------
  1 | Alice   | 100.50
  2 | Bob     | 200.75
  3 | Charlie | 300.00
(3 rows)

SELECT COUNT(*) FROM s3_hive_text;
 count 
-------
     3
(1 row)

-- ============================================================
-- Test 5: Hive CSV (OpenCSVSerde) -> CB read
-- ============================================================
DROP FOREIGN TABLE IF EXISTS s3_hive_csv;
NOTICE:  foreign table "s3_hive_csv" does not exist, skipping
CREATE FOREIGN TABLE s3_hive_csv (id int, name text, amount decimal(10,2))
SERVER s3_server
OPTIONS (filePath '/warehouse/s3-smoke-hive-csv/', format 'csv', delimiter ',', quote '"');
SELECT * FROM s3_hive_csv ORDER BY id;
 id |  name   | amount 
----+---------+--------
  1 | Alice   | 100.50
  2 | Bob     | 200.75
  3 | Charlie | 300.00
(3 rows)

SELECT COUNT(*) FROM s3_hive_csv;
 count 
-------
     3
(1 row)

-- Cleanup
DROP FOREIGN TABLE IF EXISTS s3_hive_parquet;
DROP FOREIGN TABLE IF EXISTS s3_hive_avro;
DROP FOREIGN TABLE IF EXISTS s3_hive_orc;
DROP FOREIGN TABLE IF EXISTS s3_hive_text;
DROP FOREIGN TABLE IF EXISTS s3_hive_csv;
DROP USER MAPPING FOR gpadmin SERVER s3_server;
DROP SERVER s3_server;
