DROP FOREIGN TABLE IF EXISTS s3_hive_avro;
NOTICE:  foreign table "s3_hive_avro" does not exist, skipping
CREATE FOREIGN TABLE s3_hive_avro (id int, name text)
SERVER s3_server
OPTIONS (filePath '/warehouse/s3-smoke-hive-avro/', format 'avro');
SELECT * FROM s3_hive_avro ORDER BY id;
 id |  name   
----+---------
  1 | Alice
  2 | Bob
  3 | Charlie
(3 rows)

SELECT COUNT(*) FROM s3_hive_avro;
 count 
-------
     3
(1 row)

