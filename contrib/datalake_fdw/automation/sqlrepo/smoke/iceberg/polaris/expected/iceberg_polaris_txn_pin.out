-- A transaction reads one head of a table on an external catalog
-- (issue #461, design point 14).
--
-- Each plan used to resolve the head again, so a REPEATABLE READ transaction
-- that read a table twice saw another engine's commit in between.  The first
-- head a transaction resolves is now kept: for the whole transaction under
-- REPEATABLE READ or SERIALIZABLE, for one statement under READ COMMITTED --
-- the same scopes PostgreSQL gives its own snapshots.
--
-- The other engine is a second connection (dblink) writing through a second
-- table bound to the same Polaris table.  pin_t sets metadata_cache 0, so
-- every unpinned read resolves the head: what keeps a read on the old head
-- here is the pin, not the metadata cache.
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS datalake_fdw;
CREATE EXTENSION IF NOT EXISTS dblink;
RESET client_min_messages;
CREATE SERVER pin_vol_srv
FOREIGN DATA WRAPPER iceberg_volume_fdw
OPTIONS (
    type 's3',
    endpoint 'http://minio:9000',
    region 'us-east-1',
    bucket_name 'warehouse',
    path_style_access 'true'
);
CREATE USER MAPPING FOR current_user
SERVER pin_vol_srv
OPTIONS (access_key_id 'admin', secret_access_key 'admin12345');
CREATE FOREIGN VOLUME pin_vol SERVER pin_vol_srv OPTIONS (base_path '/');
CREATE SERVER pin_cat_srv
FOREIGN DATA WRAPPER iceberg_catalog_fdw
OPTIONS (type 'polaris', url 'http://polaris:8181/api/catalog');
CREATE USER MAPPING FOR current_user
SERVER pin_cat_srv
OPTIONS (client_id 'root', client_secret 's3cr3t', scope 'PRINCIPAL_ROLE:ALL');
CREATE FOREIGN CATALOG pin_cat
SERVER pin_cat_srv
OPTIONS (catalog_name 'polaris_default_catalog');
CREATE ICEBERG TABLE pin_t (id int) CATALOG pin_cat VOLUME pin_vol
OPTIONS (metadata_cache '0');
INSERT INTO pin_t VALUES (1);
CREATE ICEBERG TABLE pin_w (id int) CATALOG pin_cat VOLUME pin_vol
OPTIONS (namespace 'public', table 'pin_t');
SELECT format('dbname=%s port=%s', current_database(), current_setting('port')) AS other
\gset
-- ============================================================
-- REPEATABLE READ: one head for the whole transaction
-- ============================================================
BEGIN ISOLATION LEVEL REPEATABLE READ;
SELECT count(*) AS first_read FROM pin_t;
 first_read 
------------
          1
(1 row)

SELECT dblink_exec(:'other', 'SET client_min_messages = error; INSERT INTO pin_w VALUES (2)');
 dblink_exec 
-------------
 INSERT 0 1
(1 row)

SELECT count(*) AS second_read FROM pin_t;
 second_read 
-------------
           1
(1 row)

COMMIT;
SELECT count(*) AS after_commit FROM pin_t;
 after_commit 
--------------
            2
(1 row)

-- ============================================================
-- READ COMMITTED: the next statement sees the other commit
-- ============================================================
BEGIN;
SELECT count(*) AS first_read FROM pin_t;
 first_read 
------------
          2
(1 row)

SELECT dblink_exec(:'other', 'SET client_min_messages = error; INSERT INTO pin_w VALUES (3)');
 dblink_exec 
-------------
 INSERT 0 1
(1 row)

SELECT count(*) AS second_read FROM pin_t;
 second_read 
-------------
           3
(1 row)

COMMIT;
-- ============================================================
-- SERIALIZABLE: one head for the whole transaction, as REPEATABLE READ
-- ============================================================
BEGIN ISOLATION LEVEL SERIALIZABLE;
SELECT count(*) AS first_read FROM pin_t;
 first_read 
------------
          3
(1 row)

SELECT dblink_exec(:'other', 'SET client_min_messages = error; INSERT INTO pin_w VALUES (4)');
 dblink_exec 
-------------
 INSERT 0 1
(1 row)

SELECT count(*) AS second_read FROM pin_t;
 second_read 
-------------
           3
(1 row)

COMMIT;
SELECT count(*) AS after_commit FROM pin_t;
 after_commit 
--------------
            4
(1 row)

-- ============================================================
-- A pinned transaction still reads its own writes
--
-- Writing a table moves its reads to the tracker, whose base is the
-- catalog's head -- a write must build on the latest snapshot.  From then on
-- the transaction reads that head plus its own rows, so the row the other
-- connection committed after the pin shows up together with its own.
-- ============================================================
BEGIN ISOLATION LEVEL REPEATABLE READ;
SELECT count(*) AS pinned_read FROM pin_t;
 pinned_read 
-------------
           4
(1 row)

SELECT dblink_exec(:'other', 'SET client_min_messages = error; INSERT INTO pin_w VALUES (5)');
 dblink_exec 
-------------
 INSERT 0 1
(1 row)

SELECT count(*) AS still_pinned FROM pin_t;
 still_pinned 
--------------
            4
(1 row)

INSERT INTO pin_t VALUES (100);
SELECT count(*) FILTER (WHERE id = 100) AS own_row,
       count(*) FILTER (WHERE id = 5) AS other_row,
       count(*) AS total
  FROM pin_t;
 own_row | other_row | total 
---------+-----------+-------
       1 |         1 |     6
(1 row)

-- The other connection's commit moved the head this transaction based its
-- write on; the catch-up warning names an OID and a metadata file.
SET client_min_messages = error;
COMMIT;
RESET client_min_messages;
SELECT count(*) AS after_commit FROM pin_t;
 after_commit 
--------------
            6
(1 row)

-- ============================================================
-- A transaction that writes first reads through the tracker throughout
-- ============================================================
BEGIN ISOLATION LEVEL REPEATABLE READ;
INSERT INTO pin_t VALUES (200);
SELECT count(*) FILTER (WHERE id = 200) AS own_row, count(*) AS total FROM pin_t;
 own_row | total 
---------+-------
       1 |     7
(1 row)

ROLLBACK;
SELECT count(*) FILTER (WHERE id = 200) AS rolled_back_row, count(*) AS total FROM pin_t;
 rolled_back_row | total 
-----------------+-------
               0 |     6
(1 row)

-- ============================================================
-- Cleanup
-- ============================================================
DROP TABLE pin_w;
DROP TABLE pin_t;
DROP CATALOG pin_cat;
DROP VOLUME pin_vol;
DROP USER MAPPING FOR current_user SERVER pin_cat_srv;
DROP SERVER pin_cat_srv;
DROP USER MAPPING FOR current_user SERVER pin_vol_srv;
DROP SERVER pin_vol_srv;
