CREATE ICEBERG TABLE ct_nulls (id bigint, c char(5));
INSERT INTO ct_nulls VALUES
    (1, 'first'),
    (2, NULL),
    (3, 'three'),
    (4, NULL),
    (5, 'fifth');
SELECT count(*) FILTER (WHERE c IS NULL)     AS null_cnt,
       count(*) FILTER (WHERE c IS NOT NULL) AS not_null_cnt,
       count(*)                              AS total
FROM ct_nulls;
 null_cnt | not_null_cnt | total 
----------+--------------+-------
        2 |            3 |     5
(1 row)

DROP TABLE ct_nulls;
