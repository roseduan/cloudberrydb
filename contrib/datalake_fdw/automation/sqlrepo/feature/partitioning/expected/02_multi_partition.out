SELECT public.sync_hive_table('hive_cluster','default','test_multi_partition','paa_cluster', 'feature_test.multi_part', 'hive_server');
 sync_hive_table 
-----------------
 t
(1 row)

-- Verify table structure
\d feature_test.multi_part
             Foreign table "feature_test.multi_part"
 Column |  Type   | Collation | Nullable | Default | FDW options 
--------+---------+-----------+----------+---------+-------------
 id     | integer |           |          |         | 
 value  | text    |           |          |         | 
 year   | integer |           |          |         | 
 month  | integer |           |          |         | 
 day    | integer |           |          |         | 
Server: hive_server
FDW options: (filepath '/warehouse/test_multi_partition', hive_cluster_name 'hive_cluster', datasource 'default.test_multi_partition', hdfs_cluster_name 'paa_cluster', enablecache 'true', transactional 'false', partitionkeys 'year,month,day', format 'orc')

