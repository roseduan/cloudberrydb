-- ============================================================
-- Test 7: Aggregates
-- ============================================================
SELECT test_log('Test 7: Aggregate functions');
NOTICE:  [TEST] Test 7: Aggregate functions
 test_log 
----------
 
(1 row)

SELECT COUNT(*) AS cnt,
       SUM(amount) AS total,
       AVG(amount) AS avg_amt,
       MIN(amount) AS min_amt,
       MAX(amount) AS max_amt
FROM is_data WHERE amount IS NOT NULL;
 cnt |  total  |       avg_amt        | min_amt | max_amt 
-----+---------+----------------------+---------+---------
   6 | 1327.49 | 221.2483333333333333 |   75.00 |  500.99
(1 row)

SELECT SUM(val) AS bulk_sum, MIN(val) AS bulk_min, MAX(val) AS bulk_max FROM is_bulk;
 bulk_sum | bulk_min | bulk_max 
----------+----------+----------
  5005000 |       10 |    10000
(1 row)

