    SERVER ne_server
    OPTIONS (filePath '/warehouse/fdw-test/feature/negative/orc_data/', format 'parquet');
    PERFORM COUNT(*) FROM ne_mismatch;
    DROP FOREIGN TABLE IF EXISTS ne_mismatch;
EXCEPTION WHEN OTHERS THEN
