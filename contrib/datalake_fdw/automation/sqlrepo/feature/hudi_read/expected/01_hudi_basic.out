-- Cleanup
-- ============================================================
DROP FOREIGN TABLE hb_cow;
DROP FOREIGN TABLE hb_mor;
DROP FOREIGN TABLE hb_nulls;
DROP USER MAPPING FOR gpadmin SERVER hudi_ft_server;
DROP SERVER hudi_ft_server;
