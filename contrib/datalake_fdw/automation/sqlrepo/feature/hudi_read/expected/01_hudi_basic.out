-- 01_hudi_basic.sql
-- Test Hudi basic read operations
\i ../../../lib/sql/common_setup.sql
-- common_setup.sql
-- Base setup for all datalake_fdw tests
-- This file should be included at the beginning of all test SQL files
-- Create required extensions
CREATE EXTENSION IF NOT EXISTS datalake_fdw;
CREATE EXTENSION IF NOT EXISTS hive_connector;
-- gp_exttable_delimiter may not be available in all environments.
-- Silence the "already exists, skipping" NOTICE emitted in CI where the
-- extension has been created by an earlier test or initdb step.
SET client_min_messages = WARNING;
DO $$ BEGIN
    CREATE EXTENSION IF NOT EXISTS gp_exttable_delimiter;
EXCEPTION WHEN OTHERS THEN
    -- Extension not available, skip silently
END $$;
RESET client_min_messages;
-- Create foreign data wrapper if not already present
-- Note: CREATE FOREIGN DATA WRAPPER does not support IF NOT EXISTS syntax
DO $$ BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_foreign_data_wrapper WHERE fdwname = 'datalake_fdw') THEN
        EXECUTE 'CREATE FOREIGN DATA WRAPPER datalake_fdw
            HANDLER datalake_fdw_handler
            VALIDATOR datalake_fdw_validator
            OPTIONS (mpp_execute ''all segments'')';
    END IF;
END $$;
-- Set standard date style for consistent output
SET datestyle = ISO, MDY;
-- Create logging utility function
CREATE OR REPLACE FUNCTION test_log(message text)
RETURNS void AS $$
BEGIN
    RAISE NOTICE '[TEST] %', message;
END;
$$ LANGUAGE plpgsql;
-- Log setup completion
SELECT test_log('Common setup completed');
NOTICE:  [TEST] Common setup completed
 test_log 
----------
 
(1 row)

SELECT test_log('Feature Test: Hudi Basic Reads');
NOTICE:  [TEST] Feature Test: Hudi Basic Reads
 test_log 
----------
 
(1 row)

-- ============================================================
-- Setup: Hudi server (HDFS-based for Hudi tables)
-- ============================================================
DROP SERVER IF EXISTS hudi_ft_server CASCADE;
NOTICE:  server "hudi_ft_server" does not exist, skipping
CREATE SERVER hudi_ft_server FOREIGN DATA WRAPPER datalake_fdw
OPTIONS (hdfs_namenodes 'hadoop', hdfs_port '8020', protocol 'hdfs',
         hdfs_auth_method 'simple', hadoop_rpc_protection 'authentication');
CREATE USER MAPPING FOR gpadmin SERVER hudi_ft_server OPTIONS (user 'gpadmin');
-- ============================================================
-- Test 1: COW table full read + COUNT
-- ============================================================
SELECT test_log('Test 1: COW table full read');
NOTICE:  [TEST] Test 1: COW table full read
 test_log 
----------
 
(1 row)

CREATE FOREIGN TABLE hb_cow (id bigint, name text, price double precision, ts bigint)
SERVER hudi_ft_server
OPTIONS (filePath 'default.hudi_cow_table', catalog_type 'hive', server_name 'hive_cluster',
         hdfs_cluster_name 'paa_cluster', table_identifier 'default.hudi_cow_table', format 'hudi');
SELECT * FROM hb_cow ORDER BY id LIMIT 10;
 id |  name   | price  |  ts  
----+---------+--------+------
  1 | Alice   |    100 | 1000
  2 | Bob     |  200.5 | 1001
  3 | Charlie |  50.75 | 1002
  4 | David   |    300 | 1003
  5 | Eve     | 150.25 | 1004
(5 rows)

SELECT COUNT(*) AS cow_count FROM hb_cow;
 cow_count 
-----------
         5
(1 row)

