-- ============================================================
-- Cleanup
-- ============================================================
DROP FOREIGN TABLE hf_part;
DROP FOREIGN TABLE hf_cow;
DROP USER MAPPING FOR gpadmin SERVER hudi_ff_server;
DROP SERVER hudi_ff_server;
