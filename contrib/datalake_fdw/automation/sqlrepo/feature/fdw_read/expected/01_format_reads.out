CREATE FOREIGN TABLE fr_multi_w (
    id int, big_id bigint, label text, amount decimal(10,2), flag boolean, d date
) SERVER fr_server
OPTIONS (filePath '/warehouse/fdw-test/feature/read/multi/', format 'parquet');
INSERT INTO fr_multi_w VALUES
    (1, 1000, 'row1', 99.99, true, '2024-01-15'),
    (2, 2000, 'row2', 199.50, false, '2024-06-30'),
    (3, 3000, 'row3', 0.01, true, '2024-12-31');
DROP FOREIGN TABLE fr_multi_w;
CREATE FOREIGN TABLE fr_multi_r (
    id int, big_id bigint, label text, amount decimal(10,2), flag boolean, d date
) SERVER fr_server
OPTIONS (filePath '/warehouse/fdw-test/feature/read/multi/', format 'parquet');
SELECT * FROM fr_multi_r ORDER BY id;
 id | big_id | label | amount | flag |     d      
----+--------+-------+--------+------+------------
