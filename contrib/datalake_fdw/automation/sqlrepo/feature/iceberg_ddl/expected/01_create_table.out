 timestamp           |  int96, int64, int32
 numeric             |  int96
 char(n),varchar(n)  |  byteArray,  fixlenbyteArray
 bytea,text          |  byteArray,  fixlenbyteArray (parquetFileWriter.cpp:745)  (seg2 172.20.0.2:7004 pid=255454) (parquetFileWriter.cpp:745)
SELECT col_bool, col_small, col_int, col_big FROM dt_alltypes;
 col_bool | col_small | col_int | col_big 
----------+-----------+---------+---------
(0 rows)

