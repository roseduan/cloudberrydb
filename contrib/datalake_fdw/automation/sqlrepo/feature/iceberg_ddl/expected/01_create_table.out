CREATE ICEBERG TABLE dt_alltypes (
    col_bool boolean,
    col_small smallint,
    col_int int,
    col_big bigint,
    col_real real,
    col_double double precision,
    col_decimal decimal(15,2),
    col_text text,
    col_varchar varchar(100),
    col_date date,
    col_ts timestamp,
    col_tstz timestamptz
);
INSERT INTO dt_alltypes VALUES (
    true, 32767, 2147483647, 9223372036854775807,
    3.14, 2.718281828,
    12345.67,
    'hello world', 'varchar value',
    '2024-06-15', '2024-06-15 12:30:00', '2024-06-15 12:30:00+00'
);
ERROR:  Type Mismatch: data in col_tstz is as define OSS protocol not supported data type. in datalake foreign table, but in parquet not define 
