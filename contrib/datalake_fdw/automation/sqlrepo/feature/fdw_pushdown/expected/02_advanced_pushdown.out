SELECT COUNT(*) AS dec_gt FROM ap_data_r WHERE amount > 500.00;
 dec_gt 
--------
    300
(1 row)

SELECT COUNT(*) AS dec_range FROM ap_data_r WHERE amount BETWEEN 100.00 AND 200.00;
 dec_range 
-----------
        41
(1 row)

