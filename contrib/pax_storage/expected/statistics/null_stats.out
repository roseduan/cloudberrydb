create table ns_b6(v int, k int) distributed replicated;
insert into ns_b6 select case when i % 2 = 0 then null else i end, i
  from generate_series(1, 10) i;
delete from ns_b6;
select * from null_stats('ns_b6');
 blk | tupcount |                           stats                           
-----+----------+-----------------------------------------------------------
