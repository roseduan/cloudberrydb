top_builddir = ../..
include $(top_builddir)/src/Makefile.global

MVN_EXISTS := $(shell command -v mvn 2> /dev/null)

# Extra maven flags, e.g. `make test MVN_FLAGS="-o -nsu"` to build against
# whatever snapshots the local repository already holds. Useful while the pom
# points at a hand-published SNAPSHOT, since resolving one afresh reaches the
# internal Nexus.
MVN_FLAGS ?=

#
# One version for both transports. The jars are told apart by their TRANSPORT,
# not by a version number: naming them dlagent-1.0.0 / dlagent-2.0.0 (as the
# old branch did) encodes a protocol choice as what looks like a product
# version, so a real agent upgrade later would leave stale artifacts and an
# ambiguous uninstall.
#
DLAGENT_VERSION = 1.0.0
DLAGENT_REST_JAR = dlagent-rest-$(DLAGENT_VERSION).jar
DLAGENT_GRPC_JAR = dlagent-grpc-$(DLAGENT_VERSION).jar

JAVA_INSTALL_DIR = $(pkglibdir)/java

all: dlagent_paths.h
	mvn $(MVN_FLAGS) package -DskipTests

#
# The tests the build above deliberately skips.
#
# `all` skips them because it runs on every `make install` of the tree and the
# suite costs about a minute; that is the right default for a build, and the
# wrong one for CI, where these ~370 assertions are the only thing standing
# between a broken transport and a release.  The build job runs this target
# after `install` and publishes */target/surefire-reports/*.xml as JUnit
# results.
#
# Not wired into `installcheck`: the test runner image has no Maven at all
# (.gitlab-ci.yml:59), which is why the jars are built once and shipped as a
# dist artifact.  This has to run where Maven is, i.e. in the build job.
#
check:
	mvn -B test

#
# The C side must name the same files this Makefile installs. Generating the
# header from the very variables used by the install rule is what makes that
# true by construction; before this, datalake_proxy.c spelled out
# "dlagent-1.0.0.jar" and the two agreed only because someone typed the same
# string twice.
#
dlagent_paths.h: Makefile
	@echo "generating $@"
	@{ \
	  echo '/*'; \
	  echo ' * GENERATED by contrib/datalake_agent/Makefile -- do not edit.'; \
	  echo ' *'; \
	  echo ' * The agent jar names, shared by the packaging rules that install them'; \
	  echo ' * and by datalake_proxy, which launches one of them according to'; \
	  echo ' * datalake.agent_transport.'; \
	  echo ' */'; \
	  echo '#ifndef DLAGENT_PATHS_H'; \
	  echo '#define DLAGENT_PATHS_H'; \
	  echo ''; \
	  echo '#define DLAGENT_VERSION   "$(DLAGENT_VERSION)"'; \
	  echo '#define DLAGENT_REST_JAR  "$(DLAGENT_REST_JAR)"'; \
	  echo '#define DLAGENT_GRPC_JAR  "$(DLAGENT_GRPC_JAR)"'; \
	  echo ''; \
	  echo '/* The entry point of each transport, launched with -cp. */'; \
	  echo '#define DLAGENT_REST_MAIN_CLASS  "cloud.elastic.dlagent.service.ServiceApplication"'; \
	  echo '#define DLAGENT_GRPC_MAIN_CLASS  "cloud.elastic.dlagent.grpc.Main"'; \
	  echo ''; \
	  echo '#endif /* DLAGENT_PATHS_H */'; \
	} > $@

# Everything that needs no infrastructure: the unit tests plus the controller
# slice tests.  The end-to-end classes are in the same run but assume their way
# out (see AgentAvailability) when no agent or object store is up, so this is
# safe to wire into CI and safe to run on a laptop.
#
# Deliberately not guarded on MVN_EXISTS the way clean is: a test target that
# quietly succeeds because the toolchain is missing is worse than one that
# fails, and this suite already spent months green without asserting anything.
test:
	mvn $(MVN_FLAGS) test

# The end-to-end pass: brings up an agent with a mock parent and drives it over
# HTTP.  Still needs the compose stack (hive metastore, object store, gopher
# store) that the request fixtures point at; without it the guarded tests skip
# and this reports success having run almost nothing.
test-e2e:
	cd test && ./make-test.sh

# dlagent_paths.h is checked in and regenerated only when this Makefile
# changes, so clean leaves it: deleting it would dirty the tree and let a
# parallel build compile datalake_proxy before the header is back.
clean:
ifdef MVN_EXISTS
	mvn clean
endif

#
# Install both transports side by side. Which one runs is a GUC, not a
# packaging decision, so both are always present -- that is what makes the
# rollback "change a setting and restart" rather than "reinstall".
#
# Uninstall first: an upgrade that only overwrites would leave a jar from a
# previous layout behind, and the manifest Class-Path of a thin jar makes a
# stale neighbour an active hazard rather than dead weight.
#
install: all uninstall-jars
	$(MKDIR_P) '$(JAVA_INSTALL_DIR)'
	DLAGENT_VERSION='$(DLAGENT_VERSION)' ./install-layout.sh '$(JAVA_INSTALL_DIR)'

uninstall-jars:
	rm -rf '$(JAVA_INSTALL_DIR)/core' '$(JAVA_INSTALL_DIR)/rest' '$(JAVA_INSTALL_DIR)/grpc'
	rm -f '$(JAVA_INSTALL_DIR)/core.cp' '$(JAVA_INSTALL_DIR)/rest.cp' '$(JAVA_INSTALL_DIR)/grpc.cp'
	@# The pre-split artifact, so an upgrade from an older install does not
	@# leave an orphan jar that nothing launches any more.  With thin jars a
	@# stale neighbour is an active hazard, not just dead weight.
	rm -f '$(JAVA_INSTALL_DIR)/dlagent-1.0.0.jar'

uninstall: uninstall-jars

distclean: clean

.PHONY: all check test test-e2e clean install uninstall uninstall-jars distclean
