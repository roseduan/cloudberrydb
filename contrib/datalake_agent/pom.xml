<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cloud.elastic</groupId>
    <artifactId>dlagent-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <!--
      Three modules, two transports, one copy of the business logic:

        dlagent-core   api + plugins + transport-neutral services. No Spring,
                       no servlet, no Tomcat - see the boundary assertion in
                       dlagent-core's ModuleBoundaryTest.
        dlagent-rest   Spring Boot composition root (service/rest +
                       service/spring). The fallback transport.
        dlagent-grpc   Guice composition root, proto contract + gRPC services.

      Version pinning lives here and only here: child modules name a
      groupId/artifactId and never a <version> for anything this
      dependencyManagement block manages, so the "child pom pins jackson to an
      older patch level than the parent" failure mode has nowhere to happen.
      PomHygieneTest enforces that mechanically.
    -->
    <modules>
        <module>dlagent-core</module>
        <module>dlagent-rest</module>
        <module>dlagent-grpc</module>
        <!--
          Tests only, ships nothing: it is the one place that can depend on
          both transports at once and ask whether they answer identically.
          See dlagent-parity/pom.xml.
        -->
        <module>dlagent-parity</module>
    </modules>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <spring-boot.version>2.7.18</spring-boot.version>
        <hadoop.version>3.4.3</hadoop.version>
        <hive.version>3.1.0</hive.version>
        <iceberg.version>1.3.0</iceberg.version>
        <hudi.version>0.13.0</hudi.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- CVE fixes: all pinned to the last Java 8 compatible patch level -->
        <!-- spring-framework 5.3.39: CVE-2024-22243/22259/22262 etc.; enforced via spring-framework-bom below -->
        <spring-framework.version>5.3.39</spring-framework.version>
        <!-- tomcat 9.0.121: CVE-2026-65905 / CVE-2026-65182 / CVE-2026-68525 (DIGEST
             and FORM authentication bypass); affects through 9.0.120. Carries the
             earlier 9.0.118 and CVE-2025-24813 fixes. Still the Java 8 line. -->
        <tomcat.version>9.0.121</tomcat.version>
        <!-- snakeyaml 2.2: CVE-2022-1471 RCE (overrides spring-boot bom default 1.30) -->
        <snakeyaml.version>2.2</snakeyaml.version>
        <!-- jetty 9.4.57: CVE-2024-22201/13009/8184/6763 (enforced via jetty-bom below).
             9.4.58 is the last 9.4 release on Maven Central and fixes nothing open
             here, so CVE-2026-2332 (fixed 9.4.60) / CVE-2026-10050 (fixed 9.4.63),
             CVE-2024-6763, CVE-2025-11143 and CVE-2026-6790 stay open on this line. -->
        <jetty.version>9.4.57.v20241219</jetty.version>
        <!-- parquet 1.15.2: CVE-2025-30065 RCE / CVE-2024-46762 / CVE-2021-41561 -->
        <parquet.version>1.15.2</parquet.version>
        <!-- avro 1.11.4: CVE-2024-47561 RCE / CVE-2023-39410 -->
        <avro.version>1.11.4</avro.version>
        <!-- netty 4.1.136: HTTP/2 Rapid Reset/MadeYouReset DoS, request smuggling, DNS
             cache poisoning etc. (overrides transitive 4.1.101); enforced via netty-bom below.
             4.1.136 adds CVE-2026-56745 / CVE-2026-55831 / CVE-2026-55833 (netty-codec-http),
             CVE-2026-56817 (netty-codec-xml) and the matching codec / codec-haproxy /
             codec-http2 / codec-stomp / handler-ssl-ocsp advisories still open in 4.1.135.
             4.1.137 adds CVE-2026-59902 (netty-transport-sctp).
             dlagent-grpc uses the non-shaded io.grpc:grpc-netty. grpc-netty-shaded
             relocates netty 4.1.132 into its own jar, where this bom cannot reach it
             and where an SBOM keyed on maven coordinates cannot see it. -->
        <netty.version>4.1.137.Final</netty.version>
        <!-- jackson 2.21.4: newer PolymorphicTypeValidator bypass via generic type
             parameters + array-subtype allowlist bypass (CVE-2026-54512 / CVE-2026-54513),
             fixed only in 2.18.8 / 2.21.4 (the 2.19/2.20 branches were not separately
             patched). Still Java 8 baseline. Overrides spring-boot's 2.13.5 and iceberg's
             2.15.2; enforced via jackson-bom below. Does NOT affect the jackson 2.9.5
             shaded inside hive-exec. 2.21.5 rather than 2.21.4 because 2.21.0-2.21.4 are
             themselves affected by GHSA-5gvw-p9qm-jgwh / GHSA-5jmj-h7xm-6q6v /
             GHSA-mhm7-754m-9p8w. 2.21.7 for CVE-2026-19032 / CVE-2026-68497 /
             CVE-2026-83557 (fixed 2.21.6) and CVE-2026-89407 / CVE-2026-89425 /
             CVE-2026-91776 / CVE-2026-91777 (fixed 2.21.7). -->
        <jackson.version>2.21.7</jackson.version>
        <!-- grpc-java 1.81.0: verified to still target Java 8 (every class in all
             11 artifacts reads major version 52, and the full RPC shape ran on
             OpenJDK 1.8.0_452).
             NOTE: dlagent-grpc uses grpc-api/core/stub/netty only. It does NOT
             use grpc-protobuf, because that would put
             com.google.protobuf:protobuf-java on the agent classpath, where
             hive-standalone-metastore / hbase-client / orc-core 1.5.1 still
             require 2.5.0. The payload is a single `bytes` field, so the
             marshalling is hand-written and pinned by protoc-generated golden
             bytes instead (see PayloadMarshaller). -->
        <grpc.version>1.81.0</grpc.version>
        <!-- zookeeper 3.9.5: CVE-2026-24308 (sensitive info in client logfile) /
             CVE-2026-24281 (ZKTrustManager PTR-fallback hostname verification), plus the
             earlier resource-consumption / auth fixes (overrides transitive 3.8.4) -->
        <zookeeper.version>3.9.5</zookeeper.version>
        <!-- aircompressor 0.27: CVE-2024-36114 (overrides iceberg-core's transitive 0.24) -->
        <aircompressor.version>0.27</aircompressor.version>
        <!-- ant 1.10.15: CVE-2020-11979 (overrides hive-common's transitive 1.9.1) -->
        <ant.version>1.10.15</ant.version>
        <!-- bcprov-jdk18on / bcpkix-jdk18on 1.85: overrides hadoop-common's transitive
             1.82. bcpkix moves with bcprov - left alone it stayed on 1.82 next to a
             1.85 provider, and 1.82 carries CVE-2026-5588 (fixed 1.84). -->
        <bcprov.version>1.85</bcprov.version>
        <!-- ivy 2.5.3: CVE-2022-37865 / CVE-2022-37866 path traversal (overrides the
             transitive 2.4.0 pulled via hive-common's `ADD JAR` support) -->
        <ivy.version>2.5.3</ivy.version>
        <!-- lz4-java: CVE-2025-12183 / CVE-2025-66566 (hive-exec / kafka bring 1.8.0). The
             org.lz4 coordinate is dead - its last release, 1.8.1, is only a relocation POM
             pointing at at.yawk.lz4, and is itself still flagged (last_affected 1.8.1). Pin
             org.lz4 to that relocation stub so every requester follows it onto the live
             coordinate, then pin at.yawk.lz4 to 1.11.4, which carries both fixes plus
             CVE-2026-106452 / CVE-2026-106453 (fixed 1.11.2) and CVE-2026-106449 /
             CVE-2026-106450 / CVE-2026-106451 (fixed 1.11.4). -->
        <lz4-java-relocation.version>1.8.1</lz4-java-relocation.version>
        <lz4-java.version>1.11.4</lz4-java.version>
        <!-- mssql-jdbc 13.4.0.jre8: CVE-2025-59250 (hive-metastore 3.1.0 brings 10.2.3.jre8).
             Microsoft only published the fix on the .jre11 classifier for the older lines, so
             move to the current .jre8 build. The agent talks to HMS over thrift and never
             opens a SQL Server metastore itself; the driver is carried for completeness. -->
        <mssql-jdbc.version>13.4.0.jre8</mssql-jdbc.version>
        <!-- libthrift 0.13.0: CVE-2018-1320 / CVE-2019-0205 (overrides hive 3.1.0's 0.9.3).
             0.13.0 is the ceiling that keeps hive 3.1.0's generated metastore stubs working;
             CVE-2020-13949 (needs 0.14.0) and CVE-2026-43869 (needs 0.23.0) stay open. -->
        <libthrift.version>0.13.0</libthrift.version>
        <!-- httpcore5 5.4.4: CVE-2026-54399 (header parsing DoS) / CVE-2026-54428
             (HPack unbounded header list, both fixed 5.4.3); overrides the transitive
             5.1.5. 5.4.4 is the core httpclient5 5.6.5 is built against. Java 8 ok. -->
        <httpcore5.version>5.4.4</httpcore5.version>
        <!-- httpclient5 5.6.5: CVE-2026-64607 (connection leak on Content-Encoding
             decode error, fixed 5.6.3). Moves with httpcore5 above, otherwise the
             spring-boot BOM leaves a 5.1.4 client on a 5.4 core. The 5.6.x line
             still builds on httpcore5 5.4.x and targets Java 8. -->
        <httpclient5.version>5.6.5</httpclient5.version>
        <!-- log4j2 2.25.5: CVE-2025-68161 (Socket Appender skips TLS hostname
             verification), CVE-2026-34477 / CVE-2026-34479 / CVE-2026-34480 and
             CVE-2026-49844; overrides spring-boot 2.7.18's 2.17.2. The 2.x line
             still targets Java 8. Enforced via log4j-bom below. -->
        <log4j2.version>2.25.5</log4j2.version>
        <!-- commons-lang3 3.18.0: CVE-2025-48924 (uncontrolled recursion in
             ClassUtils.getClass); overrides spring-boot's 3.12.0. -->
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <!-- commons-configuration2 2.15.0: CVE-2026-45205 (StackOverflowError on
             cyclic YAML); overrides hadoop-common's transitive 2.10.1. -->
        <commons-configuration2.version>2.15.0</commons-configuration2.version>
        <!-- commons-io 2.22.0: what commons-configuration2 2.15.0 is built
             against. Its FileLocatorUtils calls IOSupplier.getUnchecked(), added
             in commons-io 2.17.0; hadoop-common's transitive 2.16.1 lacks it, so
             the first S3AFileSystem in a JVM fails with NoSuchMethodError while
             Hadoop metrics load their config. -->
        <commons-io.version>2.22.0</commons-io.version>
        <!-- groovy-all 2.4.21: CVE-2020-17521 (information disclosure through the
             shared temp directory); overrides hive-exec's transitive 2.4.11. Stays on
             2.4.x, the line hive 3.1.0 is built against. -->
        <groovy-all.version>2.4.21</groovy-all.version>

        <!-- ===== Four coordinates the single-module pom never named at all =====
             All four used to arrive only by transitivity, which was survivable
             while one fat jar held everything and unacceptable once the same
             core code is assembled by two different transports: the version
             core is compiled and unit-tested against would not be the version
             it runs against. -->

        <!-- guava: was resolving to 32.0.1-jre purely via hadoop, while grpc-java
             1.81.0 declares 33.5.0-android; without a pin, core would face a
             different flavour under each transport.

             Flavour choice: -jre, decided on measured API deltas rather than on
             matching grpc's declared coordinate. Dumping every public member of
             all three jars with javap and diffing at Class#method granularity:
               32.0.1-jre -> 33.5.0-jre     0 public methods removed (115 added)
               32.0.1-jre -> 33.5.0-android 67 public methods removed
             The android removals are not exotic: Predicate#test,
             ImmutableList#forEach/sort/spliterator, ImmutableMap#merge/
             putIfAbsent/replaceAll, Multiset#forEach, FluentIterable#stream.
             hadoop 3.4.3 / hive 3.1.0 / iceberg 1.3.0 / parquet 1.15.2 are all
             compiled against the JRE flavour and are free to call any of them,
             so -android buys a NoSuchMethodError risk we cannot bound, while
             -jre is a strict superset of what resolves today and therefore the
             option that leaves the REST path (the rollback path, whose
             behaviour must not change) alone.
             grpc uses no guava API that -jre lacks; -jre is the flavour Guava
             documents for non-Android JVMs. -->
        <guava.version>33.5.0-jre</guava.version>
        <!-- guice 5.1.0: the Guice composition root of dlagent-grpc.
             The tree already carries three inconsistent guice coordinates via
             hadoop/hive (guice 4.2.3, guice-servlet 4.2.3,
             guice-assistedinject 3.0), so leaving it unmanaged would put a
             different guice in core than in grpc. Because core resolves this
             same pinned guice transitively, install-layout.sh stores the jar
             once under core/ - the naive "single-transport dependency goes in
             that transport's directory" rule would put two different guice
             versions on one classpath. -->
        <guice.version>5.1.0</guice.version>
        <!-- javax.inject 1: the JSR-330 annotations dlagent-core is now written
             against. It used to be a fourth-level
             transitive of hadoop -> guice; a hadoop bump could have made core
             stop compiling. -->
        <javax-inject.version>1</javax-inject.version>
        <!-- micrometer-core 1.9.17: MetricsReporter's meters. Its only supplier
             was spring-boot-starter-actuator, i.e. exactly the dependency core
             sheds. Version is the one the tree resolves today. -->
        <micrometer.version>1.9.17</micrometer.version>
    </properties>

