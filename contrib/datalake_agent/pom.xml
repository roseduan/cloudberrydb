            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.client5</groupId>
                <artifactId>httpclient5</artifactId>
                <version>${httpclient5.version}</version>
            </dependency>
            <!-- hadoop-yarn-server-* 3.4.3: CVE-2021-33036 (user-account escalation in
                 yarn-server-common). hive-metastore/hive-exec 3.1.0 drag these YARN server
                 modules in at 3.1.0 while the rest of Hadoop is already pinned to 3.4.3
                 above; align them to ${hadoop.version} so the whole Hadoop graph is
                 consistent and the CVE-fixed 3.4.3 wins. -->
            <dependency>
                <groupId>org.apache.hadoop</groupId>
                <artifactId>hadoop-yarn-server-common</artifactId>
                <version>${hadoop.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.hadoop</groupId>
                <artifactId>hadoop-yarn-server-applicationhistoryservice</artifactId>
                <version>${hadoop.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.hadoop</groupId>
                <artifactId>hadoop-yarn-server-resourcemanager</artifactId>
                <version>${hadoop.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.hadoop</groupId>
                <artifactId>hadoop-yarn-server-web-proxy</artifactId>
                <version>${hadoop.version}</version>
            </dependency>
            <!-- Align the WHOLE HBase module set to 2.4.9. hive-metastore:3.1.0 drags in
                 hbase-client:2.0.0-alpha4 and its siblings (hbase-common, hbase-protocol,
                 hbase-protocol-shaded, hbase-hadoop-compat, hbase-hadoop2-compat all at
                 2.0.0-alpha4), while hudi-common pulls hbase-server:2.4.9 for reading the
                 Hudi metadata-table (MDT) HFiles. Mixing the two majors breaks MDT reads in
                 two ways that only surface once hudi-presto-bundle (a shaded uber jar that
                 embedded its own relocated HBase) is dropped:
                   1) the alpha4 *-compat jars reference the old hbase-thirdparty 1.x package
                      org.apache.hadoop.hbase.shaded.* while the fat jar only ships
                      hbase-shaded-miscellaneous-3.5.1 (3.x, org.apache.hbase.thirdparty.*) ->
                      NoClassDefFoundError: .../shaded/com/google/common/cache/CacheLoader at
                      HFile.<clinit>;
                   2) alpha4 hbase-common's CellComparator has no static getInstance() factory
                      (added in hbase 2.1), but the 2.4.9 FixedFileTrailer calls it ->
                      NoSuchMethodError: CellComparator.getInstance() when reading the HFile
                      trailer.
                 Pin every HBase artifact to 2.4.9 so the whole graph is internally consistent
                 with hbase-server-2.4.9. Declared before the spring-boot-dependencies import so
                 these versions win. -->
            <dependency>
                <groupId>org.apache.hbase</groupId>
                <artifactId>hbase-common</artifactId>
                <version>2.4.9</version>
            </dependency>
            <dependency>
                <groupId>org.apache.hbase</groupId>
                <artifactId>hbase-client</artifactId>
                <version>2.4.9</version>
            </dependency>
            <dependency>
                <groupId>org.apache.hbase</groupId>
                <artifactId>hbase-protocol</artifactId>
                <version>2.4.9</version>
            </dependency>
            <dependency>
                <groupId>org.apache.hbase</groupId>
                <artifactId>hbase-protocol-shaded</artifactId>
                <version>2.4.9</version>
            </dependency>
            <dependency>
                <groupId>org.apache.hbase</groupId>
                <artifactId>hbase-hadoop2-compat</artifactId>
                <version>2.4.9</version>
            </dependency>
            <dependency>
                <groupId>org.apache.hbase</groupId>
                <artifactId>hbase-hadoop-compat</artifactId>
                <version>2.4.9</version>
            </dependency>
            <!-- ===== The four coordinates that had no pin at all; see the properties ===== -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.inject</groupId>
                <artifactId>guice</artifactId>
                <version>${guice.version}</version>
            </dependency>
            <dependency>
                <groupId>javax.inject</groupId>
                <artifactId>javax.inject</artifactId>
                <version>${javax-inject.version}</version>
            </dependency>
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-core</artifactId>
                <version>${micrometer.version}</version>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- grpc-netty pulls netty; the netty-bom above already pins 4.1.136
                 for the HTTP/2 Rapid Reset CVEs, and declaring grpc-bom after it
                 keeps that pin winning (first declaration wins under import
                 scope). This is also why the non-shaded grpc-netty is used
                 rather than grpc-netty-shaded, which embeds netty 4.1.132 under
                 a relocated package where no version pin or SBOM scan can reach
                 it. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>2.20.26</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Test harness and lombok, declared here so the modules do not
                 have to name versions. -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>5.8.2</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>5.8.2</version>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>4.5.1</version>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>
                <version>4.5.1</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>1.18.12</version>
            </dependency>
            <!-- The modules themselves, so dlagent-rest / dlagent-grpc name no version. -->
            <dependency>
                <groupId>cloud.elastic</groupId>
                <artifactId>dlagent-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>nexus-releases</id>
            <name>HashData Releases</name>
            <url>https://nexus.hashdata.dev/repository/maven-hosted/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>nexus-snapshots</id>
            <name>HashData Snapshots</name>
            <url>https://nexus.hashdata.dev/repository/maven-snapshot-hosted/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>daily</updatePolicy>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.9.1</version>
                <!-- Aggregate BOM: run once, on the aggregator, not once per module. -->
                <inherited>false</inherited>
                <executions>
                    <execution>
                    <phase>package</phase>
                    <goals>
                        <goal>makeAggregateBom</goal>
                    </goals>
                    </execution>
                </executions>
                <configuration>
                    <projectType>application</projectType>
                    <schemaVersion>1.6</schemaVersion>
                    <outputFormat>json</outputFormat>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                    <encoding>UTF-8</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.12</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <!--
                  THE THIN-JAR LAYOUT.

                  Each module emits an ORDERED classpath file listing its
                  dependencies; the install rule turns those into
                  core.cp / rest.cp / grpc.cp under pkglib/java.

                  Ordered, and explicitly so, rather than a "lib/*" wildcard:
                  the JVM leaves the expansion order of a wildcard classpath
                  entry unspecified, while `bundle` 2.35.4 and `s3` 2.20.26
                  share 98.5% of their class names. Under a
                  fat jar the winner was fixed by the packaging; under a
                  wildcard it would be whatever the filesystem returned that
                  day; the kind of difference that surfaces as one segment
                  reading a file wrong. The REST path is the rollback path and
                  must go on behaving as it does, so the order is pinned here.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>emit-ordered-classpath</id>
                        <!--
                          BEFORE test, not at package. InstalledClasspathTest
                          asserts on these two outputs, so binding them to the
                          package phase makes "mvn clean package" (the
                          canonical command) fail on a clean tree while
                          passing on a warm one: a test that depends on what
                          the previous build left behind.
                        -->
                        <phase>process-classes</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.build.directory}/classpath.txt</outputFile>
                            <!--
                              Runtime classpath only.  build-classpath lists
                              every scope by default, which put junit, mockito,
                              spring-test, the build JDK's tools.jar (system
                              scope) and a .pom on the installed classpath, and
                              spring-boot-devtools (optional; the fat jar's
                              repackage used to drop it), which once present
                              renames the main thread, turns on extra exception
                              logging and opens a LiveReload server on
                              *:35729.
                            -->
                            <includeScope>runtime</includeScope>
                            <excludeTypes>pom</excludeTypes>
                            <excludeArtifactIds>spring-boot-devtools</excludeArtifactIds>
                            <prefix>__DLAGENT_LIB__</prefix>
                            <fileSeparator>/</fileSeparator>
                            <pathSeparator>:</pathSeparator>
                        </configuration>
                    </execution>
                    <execution>
                        <!--
                          THE SAME LIST AGAIN, AS PATHS THAT EXIST.

                          classpath.txt above is the CONTRACT: placeholder
                          prefix, installed order, read by the C side.  This
                          one is the SOURCE: where each of those jars can be
                          copied from right now, so install-layout.sh and
                          InstalledClasspathTest can open the files without
                          anything having to duplicate them first.

                          It is deliberately not a copy-dependencies
                          execution materialising every module's whole
                          dependency tree under target/deps.  Inherited by all
                          four modules, that writes the same jars four times,
                          4.1 GB of contrib/datalake_agent, of which
                          bundle-2.35.4.jar alone is 686 MB stored four times,
                          and pushes the pipeline's `database` cache past what
                          the object store accepts in one PUT:

                            Creating cache cache-pipeline-database-x86_64-...
                            FATAL: received: 400 Bad Request
                            Failed to create cache

                          which leaves every test job in the pipeline without a
                          source tree.  A one-module, one-fat-jar agent stays
                          under the limit; four modules do not.
                          Nothing needs the copies: both consumers want
                          a list of jars, and that is what this file is.
                        -->
                        <id>emit-source-classpath</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.build.directory}/classpath-src.txt</outputFile>
                            <!-- Must select exactly what classpath.txt does. -->
                            <includeScope>runtime</includeScope>
                            <excludeTypes>pom</excludeTypes>
                            <excludeArtifactIds>spring-boot-devtools</excludeArtifactIds>
                            <fileSeparator>/</fileSeparator>
                            <pathSeparator>:</pathSeparator>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
                <configuration>
                    <!--
                      *IntegrationTest talks to a dlagent that must already be
                      listening on localhost:8080 (see the class javadoc and
                      test/make-test.sh, which starts the agent first and then
                      runs `mvn test -Dtest=IcebergRestControllerIntegrationTest`).
                      Left in the default run they fail every `mvn package` with
                      ResourceAccessException, which is why `make all` passes
                      -DskipTests. Excluding them here makes the default build
                      meaningful again; an explicit -Dtest= selection overrides
                      excludes, so make-test.sh still runs them.
                    -->
                    <excludes>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- #580 guard: ban legacy Log4j 1.x (log4j:log4j) from creeping back in transitively -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>ban-log4j1</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>log4j:log4j</exclude>
                                    </excludes>
                                    <message>Legacy Log4j 1.x (log4j:log4j) is excluded and replaced by reload4j + log4j-1.2-api; do not reintroduce it (see #580).</message>
                                </bannedDependencies>
                                <!--
                                  Half of the "no version in a child pom" rule:
                                  this catches a coordinate declared twice in one
                                  pom. The other half - a child re-declaring a
                                  version for something this parent already
                                  manages - has no built-in enforcer rule, so it
                                  is asserted by PomHygieneTest, which parses all
                                  four poms.
                                -->
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
