                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bcprov.version}</version>
            </dependency>
            <!-- ivy 2.5.3: CVE-2022-37865 / CVE-2022-37866 (transitive via hive-common) -->
            <dependency>
                <groupId>org.apache.ivy</groupId>
                <artifactId>ivy</artifactId>
                <version>${ivy.version}</version>
            </dependency>
            <!-- lz4-java: CVE-2025-12183 / CVE-2025-66566 (transitive via hive-exec).
