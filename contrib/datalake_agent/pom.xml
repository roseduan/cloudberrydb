    <dependencyManagement>
        <dependencies>
            <!-- ===== CVE fixes: these overrides MUST precede the spring-boot-dependencies import (under import scope, first declaration wins) ===== -->
            <!-- spring-framework 5.3.39: CVE-2024-22243/22259/22262 etc. (overrides spring-boot 2.7.18 default 5.3.31) -->
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-framework-bom</artifactId>
                <version>${spring-framework.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- jetty 9.4.57: CVE-2024-22201/13009/8184/6763 (overrides hadoop's transitive 9.4.52) -->
