            <!-- commons-configuration2 2.15.0: CVE-2026-45205 (via hadoop-common) -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-configuration2</artifactId>
                <version>${commons-configuration2.version}</version>
            </dependency>
            <!-- commons-io 2.22.0: required by commons-configuration2 2.15.0; see the properties. -->
            <dependency>
