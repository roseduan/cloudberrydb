<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cloud.elastic</groupId>
    <artifactId>dlagent</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <spring-boot.version>2.7.18</spring-boot.version>
        <hadoop.version>3.4.3</hadoop.version>
        <hive.version>3.1.0</hive.version>
        <iceberg.version>1.3.0</iceberg.version>
        <hudi.version>0.13.0</hudi.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- CVE fixes: all pinned to the last Java 8 compatible patch level -->
        <!-- spring-framework 5.3.39: CVE-2024-22243/22259/22262 etc.; enforced via spring-framework-bom below -->
        <spring-framework.version>5.3.39</spring-framework.version>
        <!-- tomcat 9.0.107: CVE-2025-24813 RCE etc. (overrides spring-boot bom default 9.0.80) -->
        <tomcat.version>9.0.107</tomcat.version>
        <!-- snakeyaml 2.2: CVE-2022-1471 RCE (overrides spring-boot bom default 1.30) -->
        <snakeyaml.version>2.2</snakeyaml.version>
        <!-- jetty 9.4.57: CVE-2024-22201/13009/8184/6763 (enforced via jetty-bom below) -->
        <jetty.version>9.4.57.v20241219</jetty.version>
        <!-- parquet 1.15.2: CVE-2025-30065 RCE / CVE-2024-46762 / CVE-2021-41561 -->
        <parquet.version>1.15.2</parquet.version>
        <!-- avro 1.11.4: CVE-2024-47561 RCE / CVE-2023-39410 -->
        <avro.version>1.11.4</avro.version>
        <!-- netty 4.1.135: HTTP/2 Rapid Reset/MadeYouReset DoS, request smuggling, DNS
             cache poisoning etc. (overrides transitive 4.1.101); enforced via netty-bom below -->
        <netty.version>4.1.135.Final</netty.version>
        <!-- jackson 2.19.4: PolymorphicTypeValidator / array-subtype allowlist bypass
             (overrides spring-boot 2.13.5); enforced via jackson-bom below -->
        <jackson.version>2.19.4</jackson.version>
        <!-- zookeeper 3.9.3: resource-consumption / auth fixes (overrides transitive 3.8.4) -->
        <zookeeper.version>3.9.3</zookeeper.version>
    </properties>

    <dependencies>
