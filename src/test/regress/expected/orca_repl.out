-- Replicated outer, distributed inner (should not use parallel semi join)
explain (costs off) select * from semi_repl where c in (select a from semi_dist);
                            QUERY PLAN                            
------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   ->  Parallel Hash Join
         Hash Cond: (semi_dist.a = semi_repl.c)
         ->  HashAggregate
               Group Key: semi_dist.a
               ->  Redistribute Motion 6:6  (slice2; segments: 6)
                     Hash Key: semi_dist.a
                     Hash Module: 3
                     ->  Parallel Seq Scan on semi_dist
         ->  Parallel Hash
               ->  Parallel Seq Scan on semi_repl
 Optimizer: GPORCA
(12 rows)

