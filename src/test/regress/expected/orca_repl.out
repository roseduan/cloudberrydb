-- EXISTS subquery: distributed outer, replicated inner
explain (costs off) select * from semi_dist where exists (select c from semi_repl where semi_dist.a = semi_repl.c);
                    QUERY PLAN                    
--------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   ->  Parallel Hash Semi Join
         Hash Cond: (semi_dist.a = semi_repl.c)
         ->  Parallel Seq Scan on semi_dist
               Filter: (NOT (a IS NULL))
         ->  Parallel Hash
               ->  Parallel Seq Scan on semi_repl
 Optimizer: GPORCA
(8 rows)

