-- Parallel GroupAgg (StreamAgg) with replicated table
set optimizer_enable_hashagg = off;
set optimizer_enable_parallel_hashagg=off;
explain (costs off) select c, count(*) from semi_repl group by c;
                             QUERY PLAN                             
--------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   ->  Finalize GroupAggregate
         Group Key: c
         ->  Sort
               Sort Key: c
               ->  Redistribute Motion 2:6  (slice2; segments: 2)
                     Hash Key: c
                     Hash Module: 3
                     ->  Partial GroupAggregate
                           Group Key: c
                           ->  Sort
                                 Sort Key: c
                                 ->  Parallel Seq Scan on semi_repl
 Optimizer: GPORCA
(14 rows)

